---
/* A small, coded picture of a custom booking system and CRM. One card moves once on load:
   a late-night enquiry gets an instant reply and lands in an open consult slot. */
const enquiries = [
  { n: 'Sophie M.', t: 'Website quote', s: 'Website', w: '18:02' },
  { n: 'Priya S.', t: 'Jumping castle, Saturday', s: 'Facebook', w: '16:47' },
];
const booked = [
  { n: 'Laura P.', t: 'Intro boxing session', w: 'Thu 11:30' },
  { n: 'Amira K.', t: 'Au pair interview', w: 'Fri 09:00' },
];
const rebook = [
  { n: 'Jess T.', t: 'Party hire balance', w: 'Due in 6 days' },
  { n: 'Naledi R.', t: 'Laser session 4 of 6', w: 'Due today' },
  { n: 'Chloe B.', t: 'Gift box reorder', w: 'Reminder sent' },
];
---
<figure class="crm" aria-label="Example of a custom booking system and CRM: a new enquiry at 22:41 gets an automatic reply and is booked into a call on Thursday at 10:00">
  <div class="crm-top" aria-hidden="true">
    <span class="crm-name"><span class="live"></span>Your business, one system</span>
    <span class="crm-stats">
      <span><b class="num">38 s</b> first reply</span>
      <span><b class="num">14</b> bookings this week</span>
    </span>
  </div>
  <div class="cols" aria-hidden="true">
    <div class="col">
      <p class="col-h">New enquiries</p>
      <div class="slot-new"></div>
      {enquiries.map((c) => (
        <div class="card"><span class="who">{c.n}</span><span class="what">{c.t}</span><span class="meta">{c.s}, {c.w}</span></div>
      ))}
    </div>
    <div class="col">
      <p class="col-h">Booked</p>
      <div class="slot-open"><span>Thu 10:00 open</span></div>
      {booked.map((c) => (
        <div class="card"><span class="who">{c.n}</span><span class="what">{c.t}</span><span class="meta when">{c.w}</span></div>
      ))}
    </div>
    <div class="col col-3">
      <p class="col-h">Follow up</p>
      {rebook.map((c) => (
        <div class="card"><span class="who">{c.n}</span><span class="what">{c.t}</span><span class="meta due">{c.w}</span></div>
      ))}
    </div>
    <div class="card mover">
      <span class="who">Nadia K.</span>
      <span class="what">Logo and website</span>
      <span class="meta m1">Instagram, 22:41</span>
      <span class="meta m2">Auto-reply sent, 22:41</span>
      <span class="meta m3 when">Call booked Thu 10:00</span>
    </div>
  </div>
  <figcaption>Example board. Every system is built around your own business.</figcaption>
</figure>

<style>
  .crm { margin: 0; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: 0 40px 100px -40px rgba(0,0,0,.8), 0 0 0 1px rgba(79,209,184,.08); overflow: hidden; }
  .crm-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 14px 18px; border-bottom: 1px solid var(--line); }
  .crm-name { font-family: var(--f-display); font-weight: 700; letter-spacing: -0.01em; display: inline-flex; align-items: center; gap: 8px; }
  .live { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
  .crm-stats { display: flex; gap: 16px; flex-wrap: wrap; font-size: .82rem; color: var(--muted); }
  .crm-stats b { color: var(--ink); font-weight: 700; }

  .cols { --gap: 12px; position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); padding: 16px 18px 18px; background: var(--bg); }
  .col { display: grid; gap: 8px; align-content: start; min-width: 0; }
  .col-h { font-size: .78rem; font-weight: 650; color: var(--muted); padding-bottom: 2px; }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; display: grid; gap: 2px; min-width: 0; height: 78px; align-content: start; }
  .who { font-weight: 650; font-size: .9rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .what { font-size: .82rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .meta { font-size: .76rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .when { color: var(--accent); font-weight: 650; }
  .due { color: var(--blush-ink); font-weight: 600; }
  .col-3 .card:nth-child(3) { background: var(--blush); border-color: transparent; }
  .col-3 .card:nth-child(3) .what { color: var(--blush-ink); }

  .slot-new { height: 78px; }
  .slot-open { height: 78px; border: 1.5px dashed var(--line); border-radius: 12px; display: grid; place-items: center; font-size: .8rem; color: var(--muted); }

  /* The mover sits over column 1's top slot, ends over column 2's open slot. */
  .mover { position: absolute; left: 18px; top: calc(16px + 1.1rem + 10px); width: calc((100% - 36px - 2 * var(--gap)) / 3); border-color: var(--accent); box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--accent) 70%, transparent); transform: translateX(calc(100% + var(--gap))); }
  .mover .meta { grid-area: 3 / 1; }
  .m1, .m2 { opacity: 0; }
  .m3 { opacity: 1; }

  @media (prefers-reduced-motion: no-preference) {
    .mover { animation: travel 4.2s cubic-bezier(.65,0,.35,1) .5s both; }
    .m1 { animation: m1 4.2s linear .5s both; }
    .m2 { animation: m2 4.2s linear .5s both; }
    .m3 { animation: m3 4.2s linear .5s both; }
    .slot-open span { animation: fill 4.2s linear .5s both; }
    @keyframes travel {
      0% { transform: translateX(0) translateY(-6px); opacity: 0; }
      8% { transform: translateX(0) translateY(0); opacity: 1; }
      62% { transform: translateX(0); }
      84%, 100% { transform: translateX(calc(100% + var(--gap))); opacity: 1; }
    }
    @keyframes m1 { 0%, 34% { opacity: 1; } 38%, 100% { opacity: 0; } }
    @keyframes m2 { 0%, 34% { opacity: 0; } 38%, 70% { opacity: 1; } 74%, 100% { opacity: 0; } }
    @keyframes m3 { 0%, 74% { opacity: 0; } 80%, 100% { opacity: 1; } }
    @keyframes fill { 0%, 76% { opacity: 1; } 80%, 100% { opacity: 0; } }
  }
  @media (prefers-reduced-motion: reduce) { .slot-open span { opacity: 0; } }
  .m2 { color: var(--accent); font-weight: 600; }

  figcaption { font-size: .8rem; color: var(--muted); padding: 10px 18px 14px; border-top: 1px solid var(--line); background: var(--surface); }

  @media (max-width: 560px) {
    .cols { grid-template-columns: repeat(2, 1fr); }
    .col-3 { display: none; }
    .mover { width: calc((100% - 36px - var(--gap)) / 2); }
  }
</style>
