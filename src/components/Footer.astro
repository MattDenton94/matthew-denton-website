---
import { NAV_LINKS, SITE, waLink } from "@/lib/site";
const year = new Date().getFullYear();
---

<footer class="border-t border-surface-border bg-ink-alt">
  <div class="container-page py-14 sm:py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="font-display text-2xl font-semibold text-paper">
          Let's build something worth being proud of.
        </p>
        <a href="/contact" class="btn-primary mt-6 inline-flex">
          Start a project
        </a>
      </div>

      <div>
        <p class="eyebrow mb-4">Site</p>
        <ul class="space-y-3 text-sm text-paper/80">
          {NAV_LINKS.map((link) => (
            <li><a href={link.href} class="hover:text-accent">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow mb-4">Contact</p>
        <ul class="space-y-3 text-sm text-paper/80">
          <li><a href={`mailto:${SITE.email}`} class="hover:text-accent">{SITE.email}</a></li>
          <li><a href={waLink("Hi Matthew, I'd like to talk about a website.")} class="hover:text-accent">WhatsApp</a></li>
          <li class="text-muted">{SITE.locationLine}</li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col gap-4 border-t border-surface-border pt-8 text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} {SITE.name}. All rights reserved.</p>
      <ul class="flex gap-5">
        {SITE.socials.map((s) => (
          <li><a href={s.href} class="hover:text-accent" rel="me noopener noreferrer" target="_blank">{s.label}</a></li>
        ))}
      </ul>
    </div>
  </div>
</footer>
