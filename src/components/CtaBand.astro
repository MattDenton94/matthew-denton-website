---
import { contact, wa, auditMsg } from '../data/site';
import WaIcon from './WaIcon.astro';
interface Props { title?: string; text?: string }
const {
  title = 'Find out where your bookings are slipping away.',
  text = "I'll message your clinic like a new client, time the reply, try to book a consult on my phone and look at your ads. Then you get a short video showing what I found and what I'd fix first. Free, and yours to keep whether we work together or not.",
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap cta-inner">
    <h2>{title}</h2>
    <div class="cta-side">
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn-light" href="/contact">Get the free audit</a>
        <a class="btn btn-line" href={wa(auditMsg)} target="_blank" rel="noopener"><WaIcon /> Ask on WhatsApp</a>
      </div>
      <p class="small">Or email <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    </div>
  </div>
</section>
<style>
  .cta-band { background: var(--band); color: var(--band-ink); padding-block: clamp(64px, 9vw, 120px); }
  .cta-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: end; }
  h2 { font-size: var(--step-3); }
  .cta-side { display: grid; gap: 20px; }
  .cta-side p { color: var(--band-muted); }
  .small { font-size: .9rem; }
  .small a { color: var(--band-ink); }
  .btn-light { background: var(--band-ink); color: var(--band); }
  .btn-line { border-color: color-mix(in srgb, var(--band-ink) 30%, transparent); color: var(--band-ink); }
  .btn-line:hover { border-color: var(--band-ink); }
  @media (max-width: 820px) { .cta-inner { grid-template-columns: 1fr; } }
</style>
