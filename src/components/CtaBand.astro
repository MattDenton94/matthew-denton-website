---
import { contact, wa } from '../data/site';
import WaIcon from './WaIcon.astro';
interface Props { title?: string; text?: string; message?: string }
const {
  title = "Tell me what's not working. I'll tell you what I'd do about it.",
  text = "Send a WhatsApp with a line or two about your business. You'll get a reply from me, usually the same day, with honest next steps and no sales script.",
  message,
} = Astro.props;
---
<section class="cta-band">
  <div class="wrap cta-inner">
    <h2>{title}</h2>
    <div class="cta-side">
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn-mark" href={wa(message)} target="_blank" rel="noopener"><WaIcon /> WhatsApp {contact.whatsappDisplay}</a>
        <a class="btn btn-line" href={`mailto:${contact.email}`}>Email instead</a>
      </div>
      <p class="mono small">{contact.email}</p>
    </div>
  </div>
</section>
<style>
  .cta-band { background: var(--band); color: var(--band-ink); padding-block: clamp(64px, 9vw, 120px); }
  .cta-inner { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: end; }
  h2 { font-size: var(--step-3); }
  .cta-side { display: grid; gap: 20px; }
  .cta-side p { color: var(--band-muted); }
  .small { font-size: .82rem; }
  .btn-mark { background: var(--mark); color: var(--mark-ink); }
  .btn-line { border-color: color-mix(in srgb, var(--band-ink) 30%, transparent); color: var(--band-ink); }
  .btn-line:hover { border-color: var(--band-ink); }
  @media (max-width: 820px) { .cta-inner { grid-template-columns: 1fr; } }
</style>
