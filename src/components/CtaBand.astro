---
import { contact, wa, projectMsg } from '../data/site';
import WaIcon from './WaIcon.astro';
interface Props { title?: string; text?: string }
const {
  title = "Let's build something that makes you money.",
  text = "Tell me what you need, whether it's a website, a booking system, a logo or ads. You'll get a clear plan and a fixed quote, usually within a day.",
} = Astro.props;
---
<section class="cta-band">
  <div class="cta-glow" aria-hidden="true"></div>
  <div class="wrap cta-inner">
    <h2>{title}</h2>
    <div class="cta-side">
      <p>{text}</p>
      <div class="btn-row">
        <a class="btn btn-dark" href="/contact">Start a project</a>
        <a class="btn btn-line" href={wa(projectMsg)} target="_blank" rel="noopener"><WaIcon /> WhatsApp me</a>
      </div>
      <p class="small">Or email <a href={`mailto:${contact.email}`}>{contact.email}</a></p>
    </div>
  </div>
</section>
<style>
  .cta-band { position: relative; overflow: hidden; background: var(--accent); color: var(--accent-ink); padding-block: clamp(72px, 10vw, 136px); }
  .cta-glow { position: absolute; width: 60vw; height: 60vw; right: -20vw; top: -30vw; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,.35), transparent 65%); pointer-events: none; }
  .cta-inner { position: relative; display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: end; }
  h2 { font-size: clamp(2.4rem, 1.4rem + 4vw, 5rem); letter-spacing: -0.045em; line-height: 1; }
  .cta-side { display: grid; gap: 20px; }
  .cta-side p { color: #0b3b33; font-size: 1.08rem; }
  .small { font-size: .92rem; }
  .small a { color: var(--accent-ink); font-weight: 600; }
  .btn-dark { background: var(--accent-ink); color: #eef2f0; }
  .btn-dark:hover { box-shadow: 0 12px 30px -12px rgba(0,0,0,.6); }
  .btn-line { border-color: rgba(4,32,27,.35); color: var(--accent-ink); }
  .btn-line:hover { border-color: var(--accent-ink); }
  @media (max-width: 820px) { .cta-inner { grid-template-columns: 1fr; } }
</style>
