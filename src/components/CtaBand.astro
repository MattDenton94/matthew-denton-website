---
import { SITE, waLink } from "@/lib/site";

interface Props {
  heading?: string;
  body?: string;
}

const {
  heading = "Got a business that deserves a better website?",
  body = "Tell me what you do and what's not working right now. I'll reply within a day, and every project is quoted individually.",
} = Astro.props;
---

<section class="border-t border-surface-border bg-ink-alt">
  <div class="container-page py-14 sm:py-20">
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow justify-center">Next step</p>
      <h2 class="mt-3 text-3xl font-semibold sm:text-4xl lg:text-5xl">{heading}</h2>
      <p class="mx-auto mt-4 max-w-prose text-base text-paper/75 sm:text-lg">{body}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-4">
        <a href="/contact" class="btn-primary">
          Start a project
        </a>
        <p class="text-sm text-muted">
          Or reach me directly —
          <a href={waLink("Hi Matthew, I'd like to talk about a website.")} class="link-underline text-paper/80">WhatsApp</a>
          or
          <a href={`mailto:${SITE.email}`} class="link-underline text-paper/80">email</a>.
        </p>
      </div>
    </div>
  </div>
</section>
