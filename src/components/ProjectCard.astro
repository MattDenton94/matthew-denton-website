---
import Phone from './Phone.astro';
import type { Project } from '../data/site';
interface Props { p: Project }
const { p } = Astro.props;
const phone = p.shots.find((s) => s.kind === 'phone');
---
<a class="pcard" href={`/work/${p.slug}`}>
  <div class={`stage stage-${p.tone}`}>
    {phone && <div class="ph"><Phone src={phone.src} alt={phone.alt} /></div>}
  </div>
  <div class="pc-body">
    <div class="pc-meta"><span class="tag">{p.tag}</span><span class="num">{p.year}</span></div>
    <h3>{p.name}</h3>
    <p>{p.kind}. {p.lesson}</p>
  </div>
</a>
<style>
  .pcard { display: grid; gap: 18px; text-decoration: none; color: inherit; align-content: start; }
  .stage { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); max-width: 100%; }
  .stage-harlan { background: #f4ece6; }
  .stage-nafts { background: #17233a; }
  .stage-tnt { background: #2f1915; }
  .stage-pearls { background: #ece2d6; }
  .ph { position: absolute; left: 50%; top: 9%; width: 50%; translate: -50% 0; transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .pcard:hover .ph { transform: translateY(-8px); }
  .pc-body { display: grid; gap: 8px; }
  .pc-meta { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: .85rem; }
  h3 { font-size: var(--step-2); }
  .pcard:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  p { color: var(--muted); }
  .tag { font-size: .8rem; font-weight: 650; padding: 3px 10px; border-radius: 999px; background: var(--surface-2); color: var(--ink); }
</style>
