---
import Mockup from './Mockup.astro';
import Phone from './Phone.astro';
import Desktop from './Desktop.astro';
import type { Project } from '../data/site';
interface Props { p: Project }
const { p } = Astro.props;
const phone = p.shots?.find((s) => s.kind === 'phone');
const desk = !phone ? p.shots?.find((s) => s.kind === 'desktop') : undefined;
---
<a class="pcard" href={`/work/${p.slug}`}>
  <div class={`stage stage-${p.mock}`}>
    {phone ? <div class="ph"><Phone src={phone.src} alt={phone.alt} /></div> : desk ? <div class="mk"><Desktop src={desk.src} alt={desk.alt} /></div> : <div class="mk"><Mockup variant={p.mock} /></div>}
  </div>
  <div class="pc-body">
    <div class="pc-meta"><span class={`tag ${p.tag === 'My own brand' ? 'own' : ''}`}>{p.tag}</span><span class="mono">{p.year}</span></div>
    <h3>{p.name}</h3>
    <p>{p.kind}. {p.place}.</p>
    <ul class="chips">{p.services.map((s) => <li class="chip">{s}</li>)}</ul>
  </div>
</a>
<style>
  .pcard { display: grid; gap: 18px; text-decoration: none; color: inherit; align-content: start; }
  .stage { position: relative; aspect-ratio: 4 / 3; border-radius: var(--radius); overflow: hidden; background: var(--surface-2); border: 1px solid var(--line); max-width: 100%; }
  .stage-harlan { background: linear-gradient(160deg, #2a2720, #141310); border-color: #2a2720; }
  .stage-nafts { background: linear-gradient(160deg, #1b2740, #0b1020); border-color: #1b2740; }
  .stage-tnt { background: linear-gradient(160deg, #3a1414, #111); border-color: #2a1a1a; }
  .stage-pearls { background: linear-gradient(160deg, #efe3d4, #d9c3a8); border-color: #e3d3bf; }
  .ph { position: absolute; left: 50%; top: 9%; width: 52%; translate: -50% 0; transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .mk { position: absolute; inset: 9% 7% auto 7%; transition: transform .4s cubic-bezier(.2,.7,.2,1); }
  .pcard:hover .ph, .pcard:hover .mk { transform: translateY(-8px); }
  .pc-body { display: grid; gap: 8px; }
  .pc-meta { display: flex; justify-content: space-between; align-items: center; color: var(--muted); font-size: .8rem; }
  h3 { font-size: var(--step-2); }
  .pcard:hover h3 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; }
  p { color: var(--muted); }
  .tag { font-family: var(--f-mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; padding: 4px 9px; border-radius: 6px; background: var(--surface-2); color: var(--ink); }
  .tag.own { background: var(--accent-soft); color: var(--accent); }
</style>
