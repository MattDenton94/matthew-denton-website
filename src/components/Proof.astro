---
/* Proof band under the hero: real numbers that count up when they scroll into view,
   and a slow strip of the brands Matt works with. Update the numbers here. */
const stats = [
  { value: 6, prefix: '', suffix: '', label: 'Active clients right now' },
  { value: 30, prefix: 'R', suffix: 'k+', label: 'In client sales generated' },
  { value: 4, prefix: '', suffix: '', label: 'Websites live in the portfolio' },
];
const brands = [
  'TNT Fitness',
  'Harlan',
  'Nautical Aerial & Fitness',
  'My Au Pairs',
  'Adamant Aesthetics',
  'Party Starters',
  'Creative Pearls',
];
---
<section class="proof" aria-label="Clients and results">
  <div class="wrap">
    <dl class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat-label">{s.label}</dt>
          <dd class="stat-num num">
            {s.prefix}<span class="count" data-to={s.value}>{s.value}</span>{s.suffix}
          </dd>
        </div>
      ))}
    </dl>
  </div>
  <div class="strip">
    <p class="strip-h wrap">Brands I build for</p>
    <div class="marquee">
      <ul class="track">
        {brands.map((b) => <li>{b}</li>)}
      </ul>
      <ul class="track" aria-hidden="true">
        {brands.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .proof { padding-block: clamp(40px, 6vw, 72px) clamp(28px, 4vw, 48px); border-top: 1px solid var(--line); background: var(--surface); }
  .stats { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 4vw, 48px); }
  .stat { display: flex; flex-direction: column-reverse; gap: 6px; border-left: 2px solid var(--accent-soft); padding-left: clamp(14px, 2vw, 22px); }
  .stat-num { margin: 0; font-family: var(--f-display); font-weight: 750; font-size: clamp(2.6rem, 1.6rem + 4vw, 4.4rem); line-height: 1; letter-spacing: -0.04em; color: var(--accent); }
  .stat-label { color: var(--muted); font-weight: 550; }
  @media (max-width: 680px) { .stats { grid-template-columns: 1fr; } }

  .strip { margin-top: clamp(36px, 5vw, 56px); }
  .strip-h { font-size: .85rem; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin-bottom: 14px; }
  .marquee { display: flex; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .track { list-style: none; margin: 0; padding: 0; display: flex; flex-shrink: 0; gap: clamp(36px, 5vw, 72px); padding-right: clamp(36px, 5vw, 72px); animation: slide 38s linear infinite; }
  .track li { font-family: var(--f-display); font-weight: 700; font-size: clamp(1.15rem, 1rem + .8vw, 1.6rem); letter-spacing: -0.02em; color: var(--ink); white-space: nowrap; opacity: .72; }
  .marquee:hover .track { animation-play-state: paused; }
  @keyframes slide { to { transform: translateX(-100%); } }
  @media (prefers-reduced-motion: reduce) {
    .marquee { flex-wrap: wrap; mask-image: none; -webkit-mask-image: none; padding-inline: var(--gutter); }
    .track { flex-wrap: wrap; gap: 12px 32px; }
    .track[aria-hidden] { display: none; }
  }
</style>

<script>
  const els = document.querySelectorAll<HTMLElement>('.proof .count');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    els.forEach((el) => (el.textContent = '0'));
    const run = (el: HTMLElement) => {
      const to = Number(el.dataset.to || 0);
      const dur = 1600;
      const t0 = performance.now();
      const tick = (t: number) => {
        const p = Math.min(1, (t - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(to * eased));
        if (p < 1) requestAnimationFrame(tick);
      };
      requestAnimationFrame(tick);
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
      });
    }, { threshold: 0.6 });
    els.forEach((el) => io.observe(el));
  }
</script>
