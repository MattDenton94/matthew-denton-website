---
import type { Testimonial } from "@/data/testimonials";

interface Props {
  testimonials: Testimonial[];
  eyebrow?: string;
  heading?: string;
  dark?: boolean;
}

const {
  testimonials,
  eyebrow = "What clients say",
  heading = "Don't just take my word for it.",
  dark = false,
} = Astro.props;
---

<section class:list={["border-b border-surface-border", dark && "bg-ink-alt"]}>
  <div class="container-page py-14 sm:py-20">
    <p class="eyebrow">{eyebrow}</p>
    <h2 class="mt-3 max-w-lg text-3xl font-semibold sm:text-4xl">{heading}</h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-3">
      {testimonials.map((t) => (
        <div class="card flex flex-col justify-between p-6 sm:p-7">
          <p class="text-lg leading-relaxed text-paper/85">&ldquo;{t.quote}&rdquo;</p>
          <div class="mt-6">
            <p class="font-display text-base font-semibold text-paper">{t.name}</p>
            <p class="text-sm text-muted">{t.role}, {t.business}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
