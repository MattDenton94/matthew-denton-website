---
// US ad landing page (HVAC, restaurants and cafés). One job: get the visitor to apply.
// Flow: pain-led hero with the first form step above the fold, proof, offer, FAQ.
// Qualified applicants book Teu's calendar; every application is saved to the CRM as region US.
// No WhatsApp anywhere on this page.
import Base from '../layouts/Base.astro';
import { CRM_INTAKE } from '../data/site';

const PIXEL_ID = '1028847063594072';
const TEU_BOOKING = 'https://calendly.com/teugcememe2/30min';
const TEU_EMAIL = 'teu@matthewdenton.co.za';

/* Real client quotes only. Add { quote, name, business } when a client gives you one.
   The section stays hidden while this is empty. */
const testimonials: { quote: string; name: string; business: string }[] = [];

const work = [
  { img: '/work/ps-home.webp', name: 'Party Starters', what: 'Party hire. New site, quote builder and a back office the owner runs herself.' },
  { img: '/work/ad-book.webp', name: 'Adamant Aesthetics', what: 'Skin and laser clinic. New site with online booking built in.' },
  { img: '/work/tnt-home.webp', name: 'TNT Fitness', what: 'Training studio. Rebuilt around real member results and one-tap booking.' },
];

const faqs = [
  { q: 'Is the preview really free?', a: 'Yes. I design a preview of your new homepage at no cost. If you don\'t love it, you walk away and owe nothing.' },
  { q: 'What does the full website cost?', a: 'From $1,500, depending on how many pages and features you need. You get a fixed price in writing before anything starts. No surprises.' },
  { q: 'How do I pay?', a: 'Only if you like the preview. A 50% deposit books the build, and the other 50% is due when the site is finished and you\'ve approved it.' },
  { q: 'How fast is it?', a: 'Your preview is usually ready a few days after our call. Most sites go live 2 to 4 weeks after the deposit.' },
  { q: 'Do I own it?', a: 'Yes. Once it\'s paid, the site and the domain are yours. No monthly lock-in to keep it online.' },
  { q: 'You\'re not in the US. Is that a problem?', a: 'No. Calls are booked in your time zone, updates come by email, and you see exactly what you\'re getting before you pay a cent.' },
];
---
<Base noWhatsApp title="Get a Free Preview of Your New Website | Matthew Denton" description="Your website should bring in customers, not send them to competitors. See a free preview of your new site first. From $1,500.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" id="eyebrow">For US business owners</p>
        <h1 id="h1">Your website is sending customers <em>to your competitors.</em></h1>
        <p class="lede" id="lede">Slow, outdated sites lose calls every day, and you never find out. I'll build a preview of your new one first. Free. You only pay if you love it.</p>
        <ul class="mini" aria-label="What you get">
          <li>Free preview first</li>
          <li>From $1,500, fixed price</li>
          <li>Live in 2 to 4 weeks</li>
        </ul>
      </div>

      <div class="card" id="apply">
        <div class="card-head">
          <p class="step-label" id="step-label">Step 1 of 3</p>
          <h2 id="card-title">Get your free preview</h2>
          <div class="bar" aria-hidden="true"><i id="bar"></i></div>
        </div>
        <form id="app" novalidate>
          <div class="step" data-step="1">
            <p class="q">What type of business do you run?</p>
            <div class="opts big" data-name="type">{['HVAC', 'Restaurant', 'Coffee shop', 'Other'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <label class="q" for="a-biz">Business name</label>
            <input id="a-biz" name="business" autocomplete="organization" placeholder="e.g. Carolina Comfort Air" />
            <label class="q" for="a-city">City and state</label>
            <input id="a-city" name="city" autocomplete="address-level2" placeholder="e.g. Charlotte, NC" />
          </div>
          <div class="step" data-step="2" hidden>
            <p class="q">Your website right now</p>
            <div class="opts" data-name="site">{['Works, but looks dated', 'Barely works', 'I don\'t have one'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <label class="q" for="a-url">Website address <span class="opt-l">optional</span></label>
            <input id="a-url" name="website" inputmode="url" placeholder="yourbusiness.com" />
            <p class="q">Websites start from $1,500. A 50% deposit books the build, only after you've seen and liked your free preview. Does that work?</p>
            <div class="opts" data-name="budget">{['Yes, that works', 'No, not right now'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">When do you want it live?</p>
            <div class="opts" data-name="when">{['As soon as possible', 'In 1 to 3 months', 'Just looking'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
          </div>
          <div class="step" data-step="3" hidden>
            <p class="good">✓ You qualify. Where should we send your preview?</p>
            <label class="q" for="a-name">Your name</label>
            <input id="a-name" name="name" autocomplete="name" />
            <label class="q" for="a-email">Email</label>
            <input id="a-email" name="email" type="email" autocomplete="email" />
            <label class="q" for="a-phone">Phone</label>
            <input id="a-phone" name="phone" type="tel" autocomplete="tel" placeholder="(704) 555-0123" />
            <input id="a-hp" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          </div>
          <div class="step done" data-step="no" hidden>
            <h3>Not quite yet</h3>
            <p>Thanks for applying. Right now the free preview is for businesses ready to start within 3 months with a website budget from $1,500. If that changes, come back any time.</p>
          </div>
          <div class="step done" data-step="yes" hidden>
            <h3 id="yes-h">You're in ✓ Pick a time</h3>
            <p id="yes-lead">Book a quick 30-minute call so we can build your preview around your business.</p>
            <div class="cal" id="cal" hidden><iframe id="cal-frame" title="Book your call" loading="lazy"></iframe></div>
            <p class="small" id="yes-mail"></p>
          </div>
          <p class="err" id="err" hidden></p>
          <div class="nav-btns" id="nav-btns">
            <button type="button" class="btn btn-ghost" id="back" hidden>Back</button>
            <button type="button" class="btn btn-primary" id="next">Next →</button>
          </div>
        </form>
        <p class="assure">🔒 Takes 60 seconds. No payment. No obligation.</p>
      </div>
    </div>
  </section>

  <section class="section pain">
    <div class="wrap narrow">
      <h2 class="h2">Sound familiar?</h2>
      <ul class="xlist" id="pain-list">
        <li>People find you on Google, tap your site, and leave in seconds.</li>
        <li>Your site looks broken or tiny on a phone, which is where most people see it.</li>
        <li>There's no clear way to call, book or order, so they go somewhere that has one.</li>
        <li>Your reviews are great, but nobody sees them on your site.</li>
      </ul>
      <p class="sting" id="sting">Every visitor who leaves is a customer your competitor just won. Your website should be your best salesperson, not the reason you lose the job.</p>
    </div>
  </section>

  <section class="section offer">
    <div class="wrap">
      <h2 class="h2 center">See it before you <mark>pay a cent</mark></h2>
      <ol class="steps">
        <li><b>Apply in 60 seconds</b><span>Answer a few quick questions and book a short call.</span></li>
        <li><b>Get your free preview</b><span>I design your new homepage around your business. No cost, no obligation.</span></li>
        <li><b>Love it? Go live</b><span>A 50% deposit books the build. Most sites go live in 2 to 4 weeks.</span></li>
      </ol>
      <p class="guarantee"><b>No preview you love, no payment.</b> That's the whole deal.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">Real sites for real businesses</h2>
      <div class="work">
        {work.map((w) => (
          <figure><img src={w.img} alt={`${w.name} website on a phone`} loading="lazy" /><figcaption><b>{w.name}</b>{w.what}</figcaption></figure>
        ))}
      </div>
      {testimonials.length > 0 && (
        <div class="quotes">
          {testimonials.map((t) => <blockquote><p>"{t.quote}"</p><cite>{t.name}, {t.business}</cite></blockquote>)}
        </div>
      )}
    </div>
  </section>

  <section class="section me">
    <div class="wrap me-grid">
      <img src="/apply-us/matt.jpg" alt="Matthew Denton" width="240" height="240" loading="lazy" />
      <div>
        <h2 class="h2">I'm Matt. I build every site myself.</h2>
        <p>No templates, no outsourcing, no 40-page contracts. I design and code each site by hand, built to make your phone ring. Before this I was a paramedic, so I'm big on clear communication and doing what I said, when I said.</p>
        <p class="small">Clients in fitness, events, clinics, childcare and retail.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <h2 class="h2">Questions</h2>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="final">
    <div class="wrap center">
      <h2 class="h2" id="final-h">Stop losing customers to a better website.</h2>
      <p class="sub">Your free preview takes 60 seconds to request. I only take on a few new builds each month.</p>
      <a class="btn btn-primary" href="#apply">Get my free preview →</a>
    </div>
  </section>

  <a class="sticky btn btn-primary" href="#apply" id="sticky">Get my free preview →</a>
</Base>

<script is:inline define:vars={{ PIXEL_ID, CRM_INTAKE, TEU_BOOKING, TEU_EMAIL }}>
  if (PIXEL_ID) {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID); fbq('track', 'PageView');
  }
  const track = (ev, data) => { try { if (window.fbq) fbq('track', ev, data || {}); } catch (e) {} };
  const $ = (id) => document.getElementById(id);

  // ---- Niche copy: ?niche=hvac or ?niche=restaurants (also reads utm_content) ----
  const qs = new URLSearchParams(location.search);
  const nicheRaw = (qs.get('niche') || qs.get('utm_content') || '').toLowerCase();
  const niche = /hvac|heat|air/.test(nicheRaw) ? 'hvac' : /rest|cafe|coffee|food/.test(nicheRaw) ? 'restaurants' : '';
  const COPY = {
    hvac: {
      eyebrow: 'For HVAC company owners',
      h1: 'Your website is sending HVAC jobs <em>to the company down the road.</em>',
      lede: 'When the AC dies at 100 degrees, people call whoever looks most trustworthy online. If your site is slow, dated or hard to use on a phone, that isn\'t you. I\'ll build a preview of your new site first. Free. You only pay if you love it.',
      pain: [
        'Homeowners find you on Google, tap your site, and call someone else.',
        'Your site is tiny or broken on a phone, which is where emergency calls come from.',
        'There\'s no big "Call now" or "Book service" button, so the job goes to whoever has one.',
        'Your 5-star reviews are buried, so you look like every other shop in town.',
      ],
      sting: 'One lost install can cost you more than this whole website. Your site should be booking jobs while you\'re out on calls, not handing them to competitors.',
      final: 'Stop handing jobs to the competition.',
      ph: ['e.g. Carolina Comfort Air', 'e.g. Charlotte, NC'],
    },
    restaurants: {
      eyebrow: 'For restaurant and café owners',
      h1: 'Hungry customers are checking your website, <em>then eating somewhere else.</em>',
      lede: 'People look at your menu, photos and hours before they ever walk in. If your site is slow, dated or just a PDF menu, they pick the place that looks better. I\'ll build a preview of your new site first. Free. You only pay if you love it.',
      pain: [
        'Your menu is a PDF that\'s impossible to read on a phone.',
        'Your photos don\'t do your food justice, so people scroll past.',
        'Hours, location and ordering links are hard to find, so they give up.',
        'The place down the street has a better site, and gets the table you should have.',
      ],
      sting: 'Every empty seat is a customer who looked you up and chose someone else. Your website should fill tables, not lose them.',
      final: 'Stop losing tables to a better website.',
      ph: ['e.g. Desert Bloom Coffee', 'e.g. Las Vegas, NV'],
    },
  };
  const c = COPY[niche];
  if (c) {
    $('eyebrow').textContent = c.eyebrow;
    $('h1').innerHTML = c.h1;
    $('lede').textContent = c.lede;
    $('pain-list').innerHTML = c.pain.map((p) => '<li>' + p + '</li>').join('');
    $('sting').textContent = c.sting;
    $('final-h').textContent = c.final;
    $('a-biz').placeholder = c.ph[0];
    $('a-city').placeholder = c.ph[1];
  }

  const form = $('app');
  const steps = [...form.querySelectorAll('.step')];
  const ans = { type: '', site: '', budget: '', when: '' };
  let cur = 1;
  let started = false;

  form.querySelectorAll('.opts').forEach((group) => {
    const name = group.dataset.name;
    group.addEventListener('click', (e) => {
      const b = e.target.closest('.opt'); if (!b) return;
      group.querySelectorAll('.opt').forEach((x) => x.classList.remove('on')); b.classList.add('on'); ans[name] = b.dataset.value;
      $('err').hidden = true;
      if (!started && e.isTrusted) { started = true; track('InitiateCheckout'); }
    });
  });
  if (niche === 'hvac') form.querySelector('[data-name="type"] [data-value="HVAC"]').click();
  if (niche === 'restaurants') form.querySelector('[data-name="type"] [data-value="Restaurant"]').click();

  const show = (id) => {
    steps.forEach((s) => (s.hidden = s.dataset.step !== String(id)));
    $('bar').style.width = (typeof id === 'number' ? (id / 3) * 100 : 100) + '%';
    $('step-label').textContent = typeof id === 'number' ? `Step ${id} of 3` : 'Done';
    $('back').hidden = !(typeof id === 'number' && id > 1);
    $('nav-btns').hidden = typeof id !== 'number';
    $('next').textContent = id === 3 ? 'Get my free preview →' : 'Next →';
  };
  const fail = (msg) => { $('err').textContent = msg; $('err').hidden = false; };
  const val = (id) => String($(id).value || '').trim();

  const utm = (qs.get('utm_source') || '').toLowerCase();
  const source = (qs.get('fbclid') || ['facebook', 'fb', 'ig', 'instagram', 'meta'].includes(utm)) ? 'Meta ad' : 'Website';
  const summary = (qualified) =>
    `${qualified ? 'Applied' : 'Applied but did not qualify'} for a free website preview (US ad${niche ? ', ' + niche : ''}). ` +
    `Business: ${val('a-biz')} (${ans.type}), ${val('a-city')}. Website now: ${ans.site}${val('a-url') ? ' (' + val('a-url') + ')' : ''}. ` +
    `Budget from $1,500 + 50% deposit: ${ans.budget}. Wants it live: ${ans.when}.`;
  const toCrm = (qualified) => {
    try {
      const d = new FormData();
      const add = (k, v) => d.append(k, v || '');
      add('name', val('a-name')); add('business', val('a-biz')); add('phone', val('a-phone')); add('email', val('a-email'));
      add('source', source); add('campaign', qs.get('utm_campaign') || 'us_leads'); add('region', 'US'); add('qualified', qualified ? 'yes' : 'no');
      add('company_url', val('a-hp'));
      add('business_type', ans.type); add('niche', niche); add('city', val('a-city'));
      add('current_website', ans.site + (val('a-url') ? ' (' + val('a-url') + ')' : ''));
      add('ad_budget', ans.budget); add('start', ans.when);
      add('message', summary(qualified));
      fetch(CRM_INTAKE, { method: 'POST', body: d, keepalive: true }).catch(() => {});
    } catch (e) { /* never block the booking step */ }
  };

  const openBooking = () => {
    if (TEU_BOOKING) {
      const u = new URL(TEU_BOOKING);
      u.searchParams.set('name', val('a-name')); u.searchParams.set('email', val('a-email'));
      u.searchParams.set('a1', `${val('a-biz')} (${ans.type}), ${val('a-city')}`);
      u.searchParams.set('embed_domain', location.hostname); u.searchParams.set('embed_type', 'Inline');
      $('cal-frame').src = u.toString(); $('cal').hidden = false;
    } else {
      $('yes-h').textContent = 'You\'re in ✓';
      $('yes-lead').textContent = 'Thanks! My team will email you within 24 hours to book a quick call about your preview.';
    }
    if (TEU_EMAIL) $('yes-mail').innerHTML = `Prefer email? Write to <a href="mailto:${TEU_EMAIL}?subject=${encodeURIComponent('Free website preview: ' + val('a-biz'))}">${TEU_EMAIL}</a>.`;
  };

  $('next').addEventListener('click', () => {
    if (cur === 1) {
      if (!ans.type) return fail('Pick your type of business.');
      if (!val('a-biz')) return fail('Add your business name.');
      if (!val('a-city')) return fail('Add your city and state.');
      if (!started) { started = true; track('InitiateCheckout'); }
      cur = 2; return show(2);
    }
    if (cur === 2) {
      if (!ans.site || !ans.budget || !ans.when) return fail('Answer the three questions to continue.');
      if (ans.budget.startsWith('No') || ans.when === 'Just looking') {
        track('Contact', { content_name: 'us_not_qualified' });
        if (!window.__mdSentNo) { window.__mdSentNo = true; toCrm(false); }
        cur = 'no'; return show('no');
      }
      cur = 3; return show(3);
    }
    if (cur === 3) {
      if (!val('a-name')) return fail('Add your name.');
      if (!/^\S+@\S+\.\S+$/.test(val('a-email'))) return fail('Add an email address we can reach you on.');
      if (val('a-phone').replace(/\D/g, '').length < 10) return fail('Add a phone number we can reach you on.');
      track('Lead', { content_name: 'us_free_preview', value: 1500, currency: 'USD' });
      toCrm(true);
      openBooking();
      cur = 'yes'; show('yes');
      $('apply').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
  $('back').addEventListener('click', () => { if (typeof cur === 'number' && cur > 1) { cur -= 1; $('err').hidden = true; show(cur); } });
  show(1);

  const sticky = $('sticky');
  new IntersectionObserver(([e]) => sticky.classList.toggle('away', e.isIntersecting), { threshold: 0.15 }).observe($('apply'));
</script>

<style>
  [hidden] { display: none !important; }
  .hero { padding-block: clamp(20px, 5vw, 64px) clamp(40px, 6vw, 80px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: start; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; gap: 20px; } }
  .hero-copy { display: grid; gap: 16px; padding-top: 8px; }
  h1 { font-size: clamp(1.9rem, 1.3rem + 2.8vw, 3.7rem); line-height: 1.05; }
  h1 :global(em) { font-style: normal; color: var(--accent); }
  .lede { color: var(--muted); font-size: clamp(1rem, .95rem + .3vw, 1.2rem); max-width: 54ch; }
  .mini { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-weight: 600; font-size: .95rem; }
  .mini li::before { content: '✓ '; color: var(--accent); }
  @media (max-width: 900px) { .lede { font-size: .98rem; } .mini { display: none; } }

  .card { background: var(--ink); color: #0b0f0e; border-radius: 22px; padding: clamp(18px, 3vw, 30px); box-shadow: 0 30px 80px -30px rgba(0,0,0,.8); position: sticky; top: 88px; scroll-margin-top: 80px; }
  @media (max-width: 900px) { .card { position: static; } }
  .card-head { display: grid; gap: 4px; margin-bottom: 14px; }
  .step-label { font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--accent-deep); }
  .card h2 { font-size: var(--step-2); }
  .bar { height: 5px; background: #dfe5e3; border-radius: 9px; overflow: hidden; margin-top: 8px; }
  .bar i { display: block; height: 100%; width: 33%; background: var(--accent-deep); transition: width .35s ease; }
  form { display: grid; gap: 12px; }
  .step { display: grid; gap: 9px; }
  .q { font-weight: 650; font-size: .95rem; display: flex; justify-content: space-between; gap: 8px; margin-top: 4px; }
  .opt-l { font-weight: 500; color: #7a8582; font-size: .85rem; }
  .card input { font: inherit; color: #0b0f0e; background: #fff; border: 1.5px solid #d3dad8; border-radius: 10px; padding: 12px 14px; width: 100%; }
  .card input:focus { outline: none; border-color: var(--accent-deep); }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opts.big { display: grid; grid-template-columns: 1fr 1fr; }
  .opts.big .opt { padding: 13px 10px; font-size: 1rem; }
  .opt { font: 600 .92rem var(--f-body); border: 1.5px solid #d3dad8; background: #fff; color: #0b0f0e; border-radius: 12px; padding: 9px 14px; cursor: pointer; transition: border-color .15s, background .15s; }
  .opt:hover { border-color: var(--accent-deep); }
  .opt.on { background: var(--accent-deep); border-color: var(--accent-deep); color: #fff; }
  .good { background: #e3f7f2; color: #0d4a40; font-weight: 650; border-radius: 10px; padding: 10px 14px; }
  .done { gap: 12px; } .done h3 { font-size: var(--step-2); } .done .small { color: #56605d; } .done :global(a) { color: var(--accent-deep); font-weight: 650; }
  .cal { border-radius: 14px; overflow: hidden; border: 1px solid #d3dad8; background: #fff; }
  .cal iframe { width: 100%; height: 680px; border: 0; display: block; }
  .err { color: #c0392b; font-weight: 650; font-size: .92rem; }
  .nav-btns { display: flex; gap: 10px; margin-top: 4px; }
  .nav-btns .btn-ghost { color: #0b0f0e; border-color: #c9d1cf; }
  #next { flex: 1; justify-content: center; background: var(--accent-deep); color: #fff; font-size: 1.05rem; padding-block: 14px; }
  .assure { margin-top: 12px; font-size: .85rem; color: #56605d; text-align: center; }

  .h2 { font-size: var(--step-3); }
  .center { text-align: center; }
  mark { background: var(--accent); color: var(--accent-ink); padding: 0 .18em; border-radius: 8px; }
  .narrow { max-width: 760px; }
  .small { font-size: .9rem; color: var(--muted); }

  .pain { background: var(--bg-2); }
  .xlist { list-style: none; padding: 0; margin: 24px 0; display: grid; gap: 12px; }
  .xlist :global(li) { position: relative; padding: 14px 16px 14px 48px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; font-size: 1.02rem; }
  .xlist :global(li)::before { content: '✕'; position: absolute; left: 16px; top: 13px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: #3a1616; color: #ff8a80; font-weight: 800; font-size: .75rem; }
  .sting { font-size: 1.15rem; font-weight: 650; border-left: 4px solid var(--accent); padding-left: 16px; }

