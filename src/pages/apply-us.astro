---
// US ad landing page: where people land after clicking the US Meta ads (HVAC, restaurants and cafés).
// Qualifies the lead, saves it to the CRM (region US, so it goes to Teu), then shows Teu's booking calendar.
// No WhatsApp anywhere on this page: US prospects book a call or email.
import Base from '../layouts/Base.astro';
import { CRM_INTAKE } from '../data/site';

const PIXEL_ID = '1028847063594072';

// ---- Fill these in ----
// Teu's booking page (Calendly, Cal.com or similar). Leave empty and qualified leads see "Teu will email you".
const TEU_BOOKING = 'https://calendly.com/teugcememe2/30min';
// Teu's email, shown as the backup contact.
const TEU_EMAIL = '';
// ------------------------

const types = ['HVAC', 'Restaurant', 'Coffee shop', 'Other'];
const faqs = [
  { q: 'Is the preview really free?', a: 'Yes. I design a preview of your new homepage first, at no cost and with no obligation. If you don\'t like it, you walk away and owe nothing.' },
  { q: 'What does a full website cost?', a: 'Websites start from $1,500, depending on how many pages and features you need (online booking, ordering links, a back office and so on). You get a fixed price in writing before anything starts.' },
  { q: 'How do I pay?', a: 'If you like your preview, a 50% deposit books the full build. The other 50% is due when the site is finished and you have approved it, before it goes live. Card payments in USD are welcome.' },
  { q: 'How long does it take?', a: 'Your preview is usually ready within a few days of our call. Most full websites go live 2 to 4 weeks after the deposit, once I have your content.' },
  { q: 'Do I own the website?', a: 'Yes. Once it\'s paid for, the website and domain are yours. No lock-in.' },
  { q: 'Who will I speak to?', a: 'Your call is with my team. They\'ll learn about your business so the preview is built around how your customers actually find and book you.' },
];
---
<Base noWhatsApp title="Get a Free Preview of Your New Website | Matthew Denton" description="A custom website for US businesses. See a free preview of your new site first. Websites from $1,500.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" id="eyebrow">For US business owners</p>
        <h1 id="h1">See your new website <em>before you pay anything.</em></h1>
        <ul class="ticks" id="ticks">
          <li><b>A free preview, first.</b> I design a preview of your new website so you see exactly what you're getting.</li>
          <li><b>Built to bring in customers.</b> Fast on mobile, easy to contact you, and set up to show up on Google.</li>
          <li><b>From $1,500, fixed price.</b> Like the preview? A 50% deposit books your full build.</li>
          <li><b>You own it.</b> No monthly lock-in to keep your site online.</li>
        </ul>
        <div class="criteria">
          <p class="tag">Who this is for</p>
          <ul>
            <li>US-based business</li>
            <li>Trading for 6+ months</li>
            <li>Website budget from $1,500</li>
            <li>Ready to start in the next 3 months</li>
          </ul>
          <p class="small"><span class="tag">No cost to apply</span> The preview is free, with no obligation.</p>
        </div>
      </div>

      <div class="card" id="apply">
        <div class="card-head">
          <h2>Get your free preview</h2>
          <p>Takes about 2 minutes. Free, no obligation.</p>
          <div class="bar" aria-hidden="true"><i id="bar"></i></div>
        </div>
        <form id="app" novalidate>
          <div class="step" data-step="1">
            <label class="q" for="a-biz">Business name</label>
            <input id="a-biz" name="business" autocomplete="organization" placeholder="e.g. Carolina Comfort Air" />
            <p class="q">What type of business?</p>
            <div class="opts" data-name="type">{types.map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <label class="q" for="a-city">City and state</label>
            <input id="a-city" name="city" autocomplete="address-level2" placeholder="e.g. Charlotte, NC" />
          </div>
          <div class="step" data-step="2" hidden>
            <p class="q">Do you have a website now?</p>
            <div class="opts" data-name="site">{['Yes, it works', 'Yes, but it needs work', 'No website'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <label class="q" for="a-url">Website address <span class="opt-l">optional</span></label>
            <input id="a-url" name="website" inputmode="url" placeholder="yourbusiness.com" />
            <p class="q">How long have you been in business?</p>
            <div class="opts" data-name="trading">{['Under 6 months', '6 to 12 months', '1 to 3 years', '3+ years'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">Rough monthly revenue?</p>
            <div class="opts" data-name="revenue">{['Under $10k', '$10k to $50k', '$50k to $150k', '$150k+'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
          </div>
          <div class="step" data-step="3" hidden>
            <p class="q">Websites start from $1,500 depending on size, with a 50% deposit to book the build after your free preview. Does that work for you?</p>
            <div class="opts" data-name="budget">{['Yes, that works', 'No, not right now'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">When do you want your new site live?</p>
            <div class="opts" data-name="when">{['As soon as possible', 'In 1 to 3 months', 'Just looking'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
          </div>
          <div class="step" data-step="4" hidden>
            <p class="good">✓ Good news, you look like a fit. Where should we reach you?</p>
            <label class="q" for="a-name">Your name</label>
            <input id="a-name" name="name" autocomplete="name" />
            <label class="q" for="a-email">Email</label>
            <input id="a-email" name="email" type="email" autocomplete="email" />
            <label class="q" for="a-phone">Phone</label>
            <input id="a-phone" name="phone" type="tel" autocomplete="tel" placeholder="(704) 555-0123" />
            <input id="a-hp" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          </div>
          <div class="step done" data-step="no" hidden>
            <h3>Not quite yet</h3>
            <p>Thanks for applying. Right now the free preview is for businesses that have been trading for 6+ months, are ready to start within 3 months, and have a website budget from $1,500.</p>
            <p>If that changes, come back any time and apply again.</p>
          </div>
          <div class="step done" data-step="yes" hidden>
            <h3 id="yes-h">You're in ✓ Now pick a time</h3>
            <p id="yes-lead">Book a quick call with my team so we can build your preview around your business.</p>
            <div class="cal" id="cal" hidden><iframe id="cal-frame" title="Book your call" loading="lazy"></iframe></div>
            <p class="small" id="yes-mail"></p>
          </div>
          <p class="err" id="err" hidden></p>
          <div class="nav-btns" id="nav-btns">
            <button type="button" class="btn btn-ghost" id="back" hidden>Back</button>
            <button type="button" class="btn btn-primary" id="next">Continue →</button>
          </div>
        </form>
        <ul class="trust"><li>Free preview</li><li>Fixed price in writing</li><li>You own your site</li></ul>
      </div>
    </div>
  </section>

  <section class="section video-sec">
    <div class="wrap">
      <h2 class="h2 center">Here's how it works</h2>
      <div class="video"><video id="vid" controls playsinline preload="none" poster="/apply-us/hvac.jpg"><source id="vid-src" src="/apply-us/hvac.mp4" type="video/mp4" /></video></div>
      <a class="btn btn-primary wide" href="#apply">Get my free preview →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2">Websites I've <mark>built</mark></h2>
      <div class="work">
        <a href="/work/creative-pearls"><img src="/work/pearls-home.webp" alt="Creative Pearls website" loading="lazy" /><p><b>Creative Pearls</b> Handmade jewellery. Website and Meta ads.</p></a>
        <a href="/work"><img src="/work/ps-home.webp" alt="Party Starters website" loading="lazy" /><p><b>Party Starters</b> Party hire. Website, quote list and back office.</p></a>
        <a href="/work"><img src="/work/ad-home.webp" alt="Adamant Aesthetics website" loading="lazy" /><p><b>Adamant Aesthetics</b> Skin and laser clinic. Website with online booking.</p></a>
      </div>
    </div>
  </section>

  <section class="section steps-sec">
    <div class="wrap">
      <h2 class="h2 center">How it works</h2>
      <ol class="steps">
        <li><b>Apply and book a call</b><span>2 minutes to apply, then a quick call with my team about your business.</span></li>
        <li><b>See your free preview</b><span>I design a preview of your new website. No cost, no obligation.</span></li>
        <li><b>Love it? Book the build</b><span>A 50% deposit books your full website. Most go live in 2 to 4 weeks.</span></li>
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap faq-wrap">
      <h2 class="h2">Questions</h2>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="final">
    <div class="wrap center">
      <h2 class="h2">See your new website <mark>before you pay.</mark></h2>
      <p class="sub">I only take on a few new builds each month, so every client gets my full attention.</p>
      <a class="btn btn-primary" href="#apply">Get my free preview →</a>
    </div>
  </section>

  <a class="sticky btn btn-primary" href="#apply" id="sticky">Get my free preview</a>
</Base>

<script is:inline define:vars={{ PIXEL_ID, CRM_INTAKE, TEU_BOOKING, TEU_EMAIL }}>
  if (PIXEL_ID) {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID); fbq('track', 'PageView');
  }
  const track = (ev, data) => { try { if (window.fbq) fbq('track', ev, data || {}); } catch (e) {} };

  // ---- Niche: ?niche=hvac or ?niche=restaurants (also reads utm_content) ----
  const qs = new URLSearchParams(location.search);
  const nicheRaw = (qs.get('niche') || qs.get('utm_content') || '').toLowerCase();
  const niche = /hvac|heat|air/.test(nicheRaw) ? 'hvac' : /rest|cafe|coffee|food/.test(nicheRaw) ? 'restaurants' : '';
  const $ = (id) => document.getElementById(id);
  if (niche === 'hvac') {
    $('eyebrow').textContent = 'For HVAC company owners';
    $('h1').innerHTML = 'A website that books jobs while you\'re out on calls. <em>See it free before you pay.</em>';
    $('ticks').children[1].innerHTML = '<b>Built for HVAC.</b> Click-to-call, online booking for repairs and installs, your service areas and reviews up front.';
  } else if (niche === 'restaurants') {
    $('eyebrow').textContent = 'For restaurant and café owners';
    $('h1').innerHTML = 'A website that fills seats. <em>See it free before you pay.</em>';
    $('ticks').children[1].innerHTML = '<b>Built for restaurants and cafés.</b> A menu you can update yourself, reservations or ordering links, Google Maps and your hours.';
    $('a-biz').placeholder = 'e.g. Desert Bloom Coffee';
    $('a-city').placeholder = 'e.g. Las Vegas, NV';
    $('vid-src').src = '/apply-us/restaurants.mp4';
    $('vid').poster = '/apply-us/restaurants.jpg';
    $('vid').load();
  }

  const form = $('app');
  const steps = [...form.querySelectorAll('.step')];
  const ans = { type: '', site: '', trading: '', revenue: '', budget: '', when: '' };
  let cur = 1;

  form.querySelectorAll('.opts').forEach((group) => {
    const name = group.dataset.name;
    group.addEventListener('click', (e) => {
      const b = e.target.closest('.opt'); if (!b) return;
      group.querySelectorAll('.opt').forEach((x) => x.classList.remove('on')); b.classList.add('on'); ans[name] = b.dataset.value;
      $('err').hidden = true;
    });
  });

  // Pre-select the business type from the ad they clicked
  if (niche === 'hvac') form.querySelector('[data-name="type"] [data-value="HVAC"]').click();

  const show = (id) => {
    steps.forEach((s) => (s.hidden = s.dataset.step !== String(id)));
    $('bar').style.width = (typeof id === 'number' ? (id - 1) / 4 * 100 + 12 : 100) + '%';
    $('back').hidden = !(typeof id === 'number' && id > 1);
    $('nav-btns').hidden = typeof id !== 'number';
    $('next').textContent = id === 4 ? 'Get my free preview →' : 'Continue →';
  };
  const fail = (msg) => { $('err').textContent = msg; $('err').hidden = false; };
  const val = (id) => String($(id).value || '').trim();

  const utm = (qs.get('utm_source') || '').toLowerCase();
  const source = (qs.get('fbclid') || ['facebook', 'fb', 'ig', 'instagram', 'meta'].includes(utm)) ? 'Meta ad' : 'Website';
  const summary = (qualified) =>
    `${qualified ? 'Applied' : 'Applied but did not qualify'} for a free website preview (US ad${niche ? ', ' + niche : ''}). ` +
    `Business: ${val('a-biz')} (${ans.type}), ${val('a-city')}. Website now: ${ans.site}${val('a-url') ? ' (' + val('a-url') + ')' : ''}. ` +
    `Trading: ${ans.trading}. Revenue: ${ans.revenue}/month. Budget from $1,500 + 50% deposit: ${ans.budget}. Wants it live: ${ans.when}.`;
  const toCrm = (qualified) => {
    try {
      const d = new FormData();
      const add = (k, v) => d.append(k, v || '');
      add('name', val('a-name')); add('business', val('a-biz')); add('phone', val('a-phone')); add('email', val('a-email'));
      add('source', source); add('campaign', qs.get('utm_campaign') || 'us_leads'); add('region', 'US'); add('qualified', qualified ? 'yes' : 'no');
      add('company_url', val('a-hp'));
      add('business_type', ans.type); add('niche', niche); add('city', val('a-city'));
      add('current_website', ans.site + (val('a-url') ? ' (' + val('a-url') + ')' : '')); add('trading', ans.trading);
      add('revenue', ans.revenue); add('ad_budget', ans.budget); add('start', ans.when);
      add('message', summary(qualified));
      fetch(CRM_INTAKE, { method: 'POST', body: d, keepalive: true }).catch(() => {});
    } catch (e) { /* never block the booking step */ }
  };

  const openBooking = () => {
    if (TEU_BOOKING) {
      const u = new URL(TEU_BOOKING);
      u.searchParams.set('name', val('a-name')); u.searchParams.set('email', val('a-email'));
      u.searchParams.set('a1', `${val('a-biz')} (${ans.type}), ${val('a-city')}`);
      u.searchParams.set('embed_domain', location.hostname); u.searchParams.set('embed_type', 'Inline');
      $('cal-frame').src = u.toString(); $('cal').hidden = false;
    } else {
      $('yes-h').textContent = 'You\'re in ✓';
      $('yes-lead').textContent = 'Thanks! My team will email you within 24 hours to book a quick call about your preview.';
    }
    if (TEU_EMAIL) $('yes-mail').innerHTML = `Prefer email? Write to <a href="mailto:${TEU_EMAIL}?subject=${encodeURIComponent('Free website preview: ' + val('a-biz'))}">${TEU_EMAIL}</a>.`;
  };

  $('next').addEventListener('click', () => {
    if (cur === 1) {
      if (!val('a-biz')) return fail('Add your business name.');
      if (!ans.type) return fail('Pick your type of business.');
      if (!val('a-city')) return fail('Add your city and state.');
      track('InitiateCheckout'); cur = 2; return show(2);
    }
    if (cur === 2) {
      if (!ans.site || !ans.trading || !ans.revenue) return fail('Answer all three to continue.');
      cur = 3; return show(3);
    }
    if (cur === 3) {
      if (!ans.budget || !ans.when) return fail('Answer both to continue.');
      const no = ans.budget.startsWith('No') || ans.when === 'Just looking' || ans.trading === 'Under 6 months';
      if (no) {
        track('Contact', { content_name: 'us_not_qualified' });
        if (!window.__mdSentNo) { window.__mdSentNo = true; toCrm(false); }
        cur = 'no'; return show('no');
      }
      cur = 4; return show(4);
    }
    if (cur === 4) {
      if (!val('a-name')) return fail('Add your name.');
      if (!/^\S+@\S+\.\S+$/.test(val('a-email'))) return fail('Add an email address we can reach you on.');
      if (val('a-phone').replace(/\D/g, '').length < 10) return fail('Add a phone number we can reach you on.');
      track('Lead', { content_name: 'us_free_preview', value: 1500, currency: 'USD' });
      toCrm(true);
      openBooking();
      cur = 'yes'; show('yes');
      $('apply').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
  $('back').addEventListener('click', () => { if (typeof cur === 'number' && cur > 1) { cur -= 1; $('err').hidden = true; show(cur); } });
  show(1);

  const sticky = $('sticky');
  new IntersectionObserver(([e]) => sticky.classList.toggle('away', e.isIntersecting), { threshold: 0.2 }).observe($('apply'));
</script>

<style>
  .hero { padding-block: clamp(36px, 6vw, 80px) clamp(48px, 7vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero-copy { display: grid; gap: 26px; }
  h1 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.9rem); }
  [hidden] { display: none !important; }
  h1 :global(em) { font-style: normal; color: var(--accent); }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ticks :global(li) { position: relative; padding-left: 36px; color: var(--muted); }
  .ticks :global(li b) { color: var(--ink); }
  .ticks :global(li)::before { content: '✓'; position: absolute; left: 0; top: 2px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font-weight: 800; font-size: .8rem; }
  .criteria { border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; background: var(--surface); display: grid; gap: 12px; }
  .criteria ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 18px; font-size: .95rem; }
  .criteria li::before { content: '✓ '; color: var(--accent); font-weight: 700; }
  @media (max-width: 520px) { .criteria ul { grid-template-columns: 1fr; } }
  .tag { display: inline-block; background: var(--accent); color: var(--accent-ink); font-weight: 700; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; justify-self: start; }
  .small { font-size: .88rem; color: var(--muted); }

  .card { background: var(--ink); color: #0b0f0e; border-radius: 22px; padding: clamp(20px, 3vw, 32px); box-shadow: 0 30px 80px -30px rgba(0,0,0,.8); position: sticky; top: 88px; scroll-margin-top: 90px; }
  @media (max-width: 900px) { .card { position: static; } }
  .card-head { display: grid; gap: 4px; margin-bottom: 18px; }
  .card h2 { font-size: var(--step-2); } .card-head p { color: #56605d; font-size: .95rem; }
  .bar { height: 5px; background: #dfe5e3; border-radius: 9px; overflow: hidden; margin-top: 10px; }
  .bar i { display: block; height: 100%; width: 12%; background: var(--accent-deep); transition: width .35s ease; }
  form { display: grid; gap: 14px; }
  .step { display: grid; gap: 10px; }
  .q { font-weight: 650; font-size: .95rem; display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; }
  .opt-l { font-weight: 500; color: #7a8582; font-size: .85rem; }
  .card input { font: inherit; color: #0b0f0e; background: #fff; border: 1.5px solid #d3dad8; border-radius: 10px; padding: 12px 14px; width: 100%; }
  .card input:focus { outline: none; border-color: var(--accent-deep); }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { font: 550 .92rem var(--f-body); border: 1.5px solid #d3dad8; background: #fff; color: #0b0f0e; border-radius: 999px; padding: 8px 14px; cursor: pointer; transition: border-color .15s, background .15s; }
  .opt:hover { border-color: var(--accent-deep); }
  .opt.on { background: var(--accent-deep); border-color: var(--accent-deep); color: #fff; }
  .good { background: #e3f7f2; color: #0d4a40; font-weight: 650; border-radius: 10px; padding: 10px 14px; }
  .done { gap: 12px; } .done h3 { font-size: var(--step-2); } .done .small { color: #56605d; } .done :global(a) { color: var(--accent-deep); font-weight: 650; }
  .cal { border-radius: 14px; overflow: hidden; border: 1px solid #d3dad8; background: #fff; }
  .cal iframe { width: 100%; height: 680px; border: 0; display: block; }
  .err { color: #c0392b; font-weight: 650; font-size: .92rem; }
  .nav-btns { display: flex; gap: 10px; justify-content: space-between; margin-top: 6px; }
  .nav-btns .btn-ghost { color: #0b0f0e; border-color: #c9d1cf; }
  #next { flex: 1; justify-content: center; background: var(--accent-deep); color: #fff; }
  .trust { list-style: none; margin: 18px 0 0; padding: 14px 0 0; border-top: 1px solid #e3e8e6; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .84rem; color: #56605d; }
  .trust li::before { content: '✓ '; color: var(--accent-deep); font-weight: 700; }

  .h2 { font-size: var(--step-3); }
  .center { text-align: center; justify-items: center; }
  mark { background: var(--accent); color: var(--accent-ink); padding: 0 .18em; border-radius: 8px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .sub { color: var(--muted); margin-top: 12px; max-width: 52ch; }
  .final .sub { margin-inline: auto; margin-bottom: 26px; }

  .video-sec .wrap { display: grid; gap: 28px; justify-items: center; }
  .video { width: 100%; max-width: 380px; aspect-ratio: 9/16; border-radius: 20px; overflow: hidden; background: var(--surface); border: 1px solid var(--line); }
  .video video { width: 100%; height: 100%; object-fit: cover; }
  .wide { width: 100%; max-width: 380px; justify-content: center; }

  .work { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin-top: 32px; }
  @media (max-width: 820px) { .work { grid-template-columns: 1fr; } }
  .work a { text-decoration: none; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; display: grid; transition: transform .2s; }
  .work a:hover { transform: translateY(-3px); }
  .work img { width: 100%; aspect-ratio: 4/3; object-fit: cover; object-position: top; }
