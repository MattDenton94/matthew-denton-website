---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import CrmBoard from '../components/CrmBoard.astro';
import { system, metrics } from '../data/site';
const crm = system.find((s) => s.slug === 'crm')!;
const flow = [
  { t: 'She sees your ad', d: 'A real client talking about her experience, not a stock photo and a discount.' },
  { t: 'She lands on the treatment page', d: 'Every question answered: what happens, downtime, aftercare, who will treat her.' },
  { t: 'She enquires at 22:41', d: 'The CRM replies in seconds with answers and a booking link, even while you sleep.' },
  { t: 'She books and gets reminded', d: 'Confirmation straight away, reminders before the day, so the consult actually happens.' },
  { t: 'She comes back', d: 'When her next treatment is due, she gets a nudge from you. Not from the clinic down the road.' },
];
---
<Base title="The system | Matthew Denton" description="Meta ads, UGC, a website built to book and a custom CRM for aesthetic clinics, working together to turn enquiries into booked consults.">
  <section class="section top">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">The system</p>
        <h1>Ads, content, website and CRM. Built as one.</h1>
        <p class="lede">Most clinics have these handled by four different people who never talk to each other. Here they're designed together, so every enquiry has a path to the treatment chair.</p>
      </div>
    </div>
  </section>

  <section class="section-tight journey">
    <div class="wrap">
      <h2 class="h2">What happens to one enquiry</h2>
      <ol class="flow">
        {flow.map((f, i) => (<li><span class="n num">{i + 1}</span><h3>{f.t}</h3><p>{f.d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap list">
      {system.map((s) => (
        <article class="row" id={s.slug}>
          <h2>{s.title}</h2>
          <div class="row-r">
            <p class="big">{s.line}</p>
            <p>{s.detail}</p>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section-tight crm-sec">
    <div class="wrap crm-grid">
      <div class="head" style="margin:0">
        <p class="eyebrow">The CRM, up close</p>
        <h2 class="h2">Custom coded around your clinic.</h2>
        <p>{crm.detail}</p>
        <p>You decide the rules: which treatments need a consult first, how long before a top-up is due, who gets alerted when a high-value enquiry comes in. The CRM follows them.</p>
      </div>
      <CrmBoard />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Monthly report</p><h2 class="h2">The six numbers you'll see every month</h2></div>
      <dl class="metrics">{metrics.map((m) => (<div><dt>{m.name}</dt><dd>{m.note}</dd></div>))}</dl>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  /* Reception photo on the right, fading into the page so the heading stays clean. */
  .top {
    padding-block: clamp(56px, 8vw, 120px) clamp(48px, 6vw, 96px);
    background:
      linear-gradient(180deg, transparent 72%, var(--bg) 100%),
      linear-gradient(90deg, var(--bg) 0%, var(--bg) 54%, color-mix(in srgb, var(--bg) 70%, transparent) 63%, color-mix(in srgb, var(--bg) 12%, transparent) 82%, transparent 100%),
      url('/clinic-reception.webp') right 0 top 46% / 47% auto no-repeat,
      var(--bg);
  }
  @media (max-width: 860px) {
    .top {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--bg) 80%, transparent) 0%, color-mix(in srgb, var(--bg) 92%, transparent) 60%, var(--bg) 100%),
        url('/clinic-reception-sm.webp') center 55% / cover no-repeat,
        var(--bg);
    }
  }
  h1 { font-size: var(--step-4); max-width: 16ch; }
  .h2 { font-size: var(--step-3); }
  .journey { background: var(--surface); border-block: 1px solid var(--line); }
  .flow { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; }
  .flow li { display: grid; gap: 8px; align-content: start; border-top: 2px solid var(--accent); padding-top: 14px; }
  .n { color: var(--accent); font-weight: 700; }
  .flow h3 { font-size: 1.1rem; letter-spacing: -0.015em; }
  .flow p { color: var(--muted); font-size: .95rem; }
  @media (max-width: 1000px) { .flow { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .flow { grid-template-columns: 1fr; } }
  .list { border-top: 2px solid var(--ink); }
  .row { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(20px, 4vw, 64px); padding-block: clamp(32px, 4vw, 52px); border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  .row h2 { font-size: var(--step-2); }
  .row-r { display: grid; gap: 16px; }
  .row-r > p:not(.big) { color: var(--muted); max-width: 62ch; }
  .big { font-family: var(--f-display); font-size: var(--step-1); line-height: 1.4; font-weight: 500; letter-spacing: -0.01em; }
  .row ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .row li { font-size: .9rem; font-weight: 550; border: 1px solid var(--line); background: var(--surface); border-radius: 999px; padding: 6px 12px; }
  @media (max-width: 860px) { .row { grid-template-columns: 1fr; } }
  .crm-sec { background: var(--accent-soft); }
  .crm-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .crm-grid p:not(.eyebrow) { color: var(--muted); }
  @media (max-width: 960px) { .crm-grid { grid-template-columns: 1fr; } }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 0 28px; }
  .metrics div { border-top: 1px solid var(--line); padding-block: 16px 20px; }
  .metrics dt { font-family: var(--f-display); font-weight: 700; font-size: 1.2rem; }
  .metrics dd { margin: 2px 0 0; color: var(--muted); }
  @media (max-width: 800px) { .metrics { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 500px) { .metrics { grid-template-columns: 1fr; } }
</style>
