---
import Base from '../layouts/Base.astro';
import CrmBoard from '../components/CrmBoard.astro';
import Phone from '../components/Phone.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { services, process, clients, stats, projects, faqs } from '../data/site';

const featured = projects.find((p) => p.slug === 'party-starters')!;
const others = projects.filter((p) => p.slug !== 'party-starters');
const words = ['custom websites', 'booking systems', 'CRMs', 'back offices', 'brands and logos', 'Meta ads'];
const marquee = ['Websites', 'Booking systems', 'CRMs', 'Back offices', 'Online stores', 'Logos', 'Branding', 'Meta ads', 'UGC'];
const path = [
  { when: '2016 to 2020', what: 'Advanced Life Support paramedic', why: 'Four years in emergency care taught me to stay calm, think in systems and look after people properly.' },
  { when: 'Then', what: 'Team lead in AI operations', why: 'Led data and quality teams at Invisible Technologies and FyxerAI. Process, automation and getting the details right.' },
  { when: 'Along the way', what: 'Café owner', why: 'I have run a business and worked in it on the same day, so I build tools for how small businesses really work.' },
  { when: 'Now', what: 'Building for businesses', why: 'Websites, systems, brands and ads for clients across five industries, plus my own brand, Harlan.' },
];
const values = [
  { t: 'You deal with me', d: 'No account managers or handovers. The person who builds it is the person who answers your WhatsApp.' },
  { t: 'Built, not templated', d: 'Every site and system is coded around your business, so it looks like you and works the way you work.' },
  { t: 'Measured on results', d: 'Enquiries, bookings and sales. Not likes, not reach.' },
  { t: 'Tested on my own money', d: 'I run my own brands, so the ads and offers I recommend have been tried with my own budget first.' },
];
---
<Base title="Matthew Denton | Custom websites, systems, branding and Meta ads">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <span class="orb o1"></span><span class="orb o2"></span><span class="grid-lines"></span>
    </div>
    <div class="wrap hero-inner">
      <p class="avail" data-h="1"><span class="pulse"></span>Taking on new projects</p>
      <h1 class="h-title">
        <span class="ln" data-h="2"><span>I build</span></span>
        <span class="ln rot-ln" data-h="3">
          <span class="rot" aria-live="off">
            {words.map((w, i) => <span class={`w ${i === 0 ? 'on' : ''}`}>{w}</span>)}
          </span>
          <span class="sr-only">custom websites, booking systems, CRMs, back offices, brands and Meta ads</span>
        </span>
        <span class="ln" data-h="4"><span>that grow your business.</span></span>
      </h1>
      <div class="hero-foot" data-h="5">
        <p class="lede">One person, start to finish. Design, code, branding and ads, built around how your business actually works, so you look the part and your enquiries turn into paying customers.</p>
        <div class="btn-row">
          <a class="btn btn-primary btn-big magnet" href="/contact">Start a project <Icon name="arrow" /></a>
          <a class="btn btn-ghost btn-big" href="/work">See my work</a>
        </div>
      </div>
    </div>
    <div class="ticker" aria-hidden="true">
      <div class="tk-track">{[...marquee, ...marquee].map((m) => <span>{m}<i>✦</i></span>)}</div>
      <div class="tk-track">{[...marquee, ...marquee].map((m) => <span>{m}<i>✦</i></span>)}</div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section clients" aria-labelledby="clients-h">
    <div class="wrap">
      <div class="head head-row">
        <div>
          <p class="eyebrow">Clients</p>
          <h2 id="clients-h">Trusted by businesses across five industries.</h2>
        </div>
        <p class="lede sm">Fitness, events, childcare, jewellery and skin care. Different customers, same goal: look the part and get more bookings.</p>
      </div>
      <ul class="logo-wall">
        {clients.map((c) => (
          <li class={`logo-tile ${c.wide ? 'wide' : ''}`} style={`--tile:${c.bg}`}>
            {c.url ? (
              <a class="lt-link" href={c.url} target="_blank" rel="noopener" aria-label={`Visit the ${c.name} website (opens in a new tab)`}>
                <div class="lt-inner" data-name={c.name}>
                  <img src={c.logo} alt={`${c.name} logo`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  {c.mark && <span class="lt-mark">{c.mark}</span>}
                </div>
                <span class="lt-cap"><b>{c.name} <span class="lt-go" aria-hidden="true">↗</span></b><span>{c.industry}</span></span>
              </a>
            ) : (
              <>
                <div class="lt-inner" data-name={c.name}>
                  <img src={c.logo} alt={`${c.name} logo`} loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                  {c.mark && <span class="lt-mark">{c.mark}</span>}
                </div>
                <span class="lt-cap"><b>{c.name}</b>{c.industry}</span>
              </>
            )}
          </li>
        ))}
        <li class="logo-tile wide next-tile">
          <a href="/contact" class="nt-inner">
            <span class="nt-plus" aria-hidden="true">+</span>
            <span class="nt-t">Your business next?</span>
            <span class="nt-s">Let's build something you're proud to show off.</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-sec" aria-label="Numbers">
    <div class="wrap">
      <dl class="stats">
        {stats.map((s) => (
          <div class="stat">
            <dt>{s.label}</dt>
            <dd class="num">{s.prefix}<span class="count" data-to={s.value}>{s.value}</span>{s.suffix}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">What I build</p>
        <h2 id="svc-h">Everything your business needs to look good and run smoothly.</h2>
        <p class="lede">Pick one thing or the whole lot. It all works together because the same person builds it.</p>
      </div>
      <ul class="svc-grid">
        {services.map((s, i) => (
          <li class="svc">
            <span class="svc-n num">{String(i + 1).padStart(2, '0')}</span>
            <span class="svc-ic"><Icon name={s.icon} /></span>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
            <ul class="svc-items">{s.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SYSTEMS SHOWCASE -->
  <section class="section systems">
    <div class="wrap sys-grid">
      <div class="sys-copy">
        <p class="eyebrow">Systems</p>
        <h2>Stop running your business from WhatsApp and spreadsheets.</h2>
        <p class="lede">I build booking systems, CRMs and back offices around the way you already work. Enquiries get answered, bookings land in the diary, and nothing falls through the cracks.</p>
        <ul class="ticks">
          <li>Every enquiry from your website, Instagram, Facebook and WhatsApp in one place</li>
          <li>Instant replies and reminders that run on their own</li>
          <li>Your services, staff, prices and rules, not someone else's template</li>
        </ul>
      </div>
      <div class="board-wrap" data-r>
        <CrmBoard />
        <div class="toast" aria-hidden="true">
          <span class="toast-dot"></span>
          <div class="toast-body">
            <span class="toast-tag">Example</span>
            <span class="toast-t">New enquiry: website quote</span>
            <span class="toast-s">Replied in 38 s, call booked Thu 10:00</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="section work" id="work">
    <div class="wrap">
      <div class="head head-row">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2>Recent builds.</h2>
        </div>
        <a class="btn btn-ghost" href="/work">All work <Icon name="arrow" /></a>
      </div>
      <div class="feature">
        <div class="feature-copy">
          <span class="tag">Featured build</span>
          <h3>{featured.name}</h3>
          <p>{featured.summary}</p>
          <ul class="bo-list">
            <li>Quote requests by email and WhatsApp</li>
            <li>Admin portal with its own login</li>
            <li>Services, prices and packages edited in-house</li>
            <li>Photo uploads and Google reviews on autopilot</li>
          </ul>
          <div class="feature-links">
            <a class="btn btn-primary" href={`/work/${featured.slug}`}>How I built it <Icon name="arrow" /></a>
            <a class="btn btn-ghost" href={featured.url} target="_blank" rel="noopener">Visit {featured.urlLabel} <span aria-hidden="true">↗</span></a>
          </div>
        </div>
        <a class="feature-shots" href={`/work/${featured.slug}`} aria-label={`How I built ${featured.name}`}>
          {featured.shots.slice(0, 2).map((sh, i) => <Phone src={sh.src} alt={sh.alt} crop class={`fs fs${i}`} />)}
        </a>
      </div>
      <div class="work-grid">
        {others.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">How it works</p>
        <h2>From first message to live, without the headaches.</h2>
      </div>
      <ol class="proc">
        {process.map((s, i) => (
          <li><span class="proc-n num">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section about" id="about" aria-labelledby="about-h">
    <div class="wrap about-grid">
      <div class="about-photo" data-r>
        <img src="/matt.webp" alt="Matthew Denton" width="720" height="960" loading="lazy" />
        <span class="ph-tag">Matthew Denton<br /><small>Cape Town, South Africa</small></span>
      </div>
      <div class="about-copy">
        <p class="eyebrow">About me</p>
        <h2 id="about-h">Hi, I'm Matt. I build things that make businesses easier to run and easier to buy from.</h2>
        <p class="lede">I'm a developer and designer from Cape Town. I build custom websites, booking systems, CRMs and back offices, design logos and brands, and run Meta ads, all under one roof.</p>
        <p>My path here wasn't typical. I spent four years as an Advanced Life Support paramedic, led data and quality teams in AI operations, and owned a café. Each of those taught me something I bring to every project: stay calm, think in systems, and never forget there is a real person on the other side of the screen.</p>
        <p>Today I work with fitness studios, party hire companies, childcare agencies, jewellery brands and skin clinics, and I run my own brands, <a href="/work/harlan">Harlan</a> and BabyBoo, where I test everything with my own money first.</p>
        <ol class="path">
          {path.map((p) => (<li><span class="when">{p.when}</span><b>{p.what}</b><span class="why">{p.why}</span></li>))}
        </ol>
      </div>
    </div>
    <div class="wrap">
      <ul class="vals">
        {values.map((v) => (<li><h3>{v.t}</h3><p>{v.d}</p></li>))}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="wrap faq-grid">
      <div class="head">
        <p class="eyebrow">Questions</p>
        <h2>Good to know</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Hero entrance, after the intro loader.
  const start = () => document.documentElement.classList.add('hero-in');
  if (document.documentElement.classList.contains('loading')) window.addEventListener('md:ready', start, { once: true });
  else start();

  // Rotating word in the headline.
  const ws = Array.from(document.querySelectorAll<HTMLElement>('.rot .w'));
  if (ws.length && !reduce) {
    let i = 0;
    setInterval(() => {
      const cur = ws[i];
      i = (i + 1) % ws.length;
      cur.classList.remove('on');
      cur.classList.add('off');
      ws[i].classList.remove('off');
      ws[i].classList.add('on');
      setTimeout(() => cur.classList.remove('off'), 700);
    }, 2400);
  }

  // Count-up numbers.
  const counts = document.querySelectorAll<HTMLElement>('.count');
  if (!reduce && 'IntersectionObserver' in window) {
    counts.forEach((el) => (el.textContent = '0'));
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        io.unobserve(el);
        const to = Number(el.dataset.to || 0);
        const t0 = performance.now();
        const tick = (t: number) => {
          const p = Math.min(1, (t - t0) / 1700);
          el.textContent = String(Math.round(to * (1 - Math.pow(1 - p, 3))));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    }, { threshold: 0.6 });
    counts.forEach((el) => io.observe(el));
  }

  // Spotlight that follows the pointer across service cards and logo tiles.
  document.querySelectorAll<HTMLElement>('.svc, .logo-tile').forEach((card) => {
    card.addEventListener('pointermove', (e) => {
      const r = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${e.clientX - r.left}px`);
      card.style.setProperty('--my', `${e.clientY - r.top}px`);
    });
  });

  // Magnetic primary button.
  if (!reduce && window.matchMedia('(pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.magnet').forEach((b) => {
      b.addEventListener('pointermove', (e) => {
        const r = b.getBoundingClientRect();
        b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * 0.18}px, ${(e.clientY - r.top - r.height / 2) * 0.3}px)`;
      });
      b.addEventListener('pointerleave', () => (b.style.transform = ''));
    });
  }

  // Live enquiry toast on the systems board.
  const toast = document.querySelector<HTMLElement>('.toast');
  const msgs = [
    ['New enquiry: website quote', 'Replied in 38 s, call booked Thu 10:00'],
    ['Instagram DM: jumping castle for Saturday?', 'Answered in 41 s, deposit paid'],
    ['Booking reminder sent', 'Client confirmed Tue 14:30'],
    ['Missed call at 19:12', 'Text-back sent, booked Sat 09:30'],
  ];
  if (toast) {
    const t = toast.querySelector('.toast-t')!;
    const s = toast.querySelector('.toast-s')!;
    let i = 0;
    const show = () => { t.textContent = msgs[i][0]; s.textContent = msgs[i][1]; toast.classList.add('show'); i = (i + 1) % msgs.length; };
    if (reduce) show();
    else {
      const io = new IntersectionObserver((en) => {
        if (!en[0].isIntersecting) return;
        io.disconnect();
        setTimeout(show, 1200);
        setInterval(() => { toast.classList.remove('show'); setTimeout(show, 600); }, 5200);
      }, { threshold: 0.4 });
      io.observe(toast.parentElement!);
    }
  }

  // Logo fallback: if a remote logo fails, show the name instead.
  document.querySelectorAll<HTMLImageElement>('.logo-tile img').forEach((img) => {
    const fail = () => { img.closest('.logo-tile')?.classList.add('no-img'); };
    if (img.complete && img.naturalWidth === 0) fail();
    img.addEventListener('error', fail);
  });
</script>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Hero */
  .hero { position: relative; overflow: hidden; padding-block: clamp(48px, 7vw, 104px) 0; min-height: calc(100svh - 68px); display: flex; flex-direction: column; justify-content: space-between; gap: clamp(48px, 7vw, 96px); }
  .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .orb { position: absolute; border-radius: 50%; filter: blur(80px); opacity: .55; }
  .o1 { width: 46vw; height: 46vw; right: -10vw; top: -14vw; background: radial-gradient(circle, rgba(79,209,184,.5), transparent 65%); animation: float1 16s ease-in-out infinite alternate; }
  .o2 { width: 34vw; height: 34vw; left: -12vw; bottom: -10vw; background: radial-gradient(circle, rgba(35,102,94,.6), transparent 65%); animation: float2 20s ease-in-out infinite alternate; }
  @keyframes float1 { to { transform: translate(-8vw, 10vw) scale(1.1); } }
  @keyframes float2 { to { transform: translate(10vw, -6vw) scale(1.15); } }
  .grid-lines { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 64px 64px; mask-image: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 50% 30%, #000 20%, transparent 75%); }
  .hero-inner { position: relative; z-index: 1; display: grid; gap: clamp(22px, 3vw, 34px); }
  .avail { display: inline-flex; align-items: center; gap: 10px; justify-self: start; font-size: .9rem; font-weight: 600; color: var(--ink); border: 1px solid var(--line); background: rgba(255,255,255,.03); padding: 8px 14px; border-radius: 999px; }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #3ddc84; box-shadow: 0 0 0 0 rgba(61,220,132,.6); animation: pulse 2s infinite; }
  @keyframes pulse { 70% { box-shadow: 0 0 0 10px rgba(61,220,132,0); } 100% { box-shadow: 0 0 0 0 rgba(61,220,132,0); } }
  .h-title { font-size: clamp(2.3rem, 0.9rem + 7vw, 6.4rem); font-weight: 750; letter-spacing: -0.045em; line-height: .98; max-width: none; display: grid; }
  .ln { display: block; overflow: hidden; padding-bottom: .06em; }
  .ln > span:not(.rot):not(.sr-only) { display: inline-block; }
  .rot { position: relative; display: inline-grid; color: var(--accent); font-size: min(1em, 10.4vw); }
  .rot .w { grid-area: 1 / 1; white-space: nowrap; transform: translateY(105%); opacity: 0; transition: transform .7s cubic-bezier(.2,.8,.2,1), opacity .7s ease; }
  .rot .w.on { transform: translateY(0); opacity: 1; }
  .rot .w.off { transform: translateY(-105%); opacity: 0; }
  .hero-foot { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(24px, 4vw, 64px); align-items: end; margin-top: 8px; }
  .hero-foot .lede { max-width: 52ch; }
  .hero-foot .btn-row { justify-content: flex-end; }
  .btn-big { padding: 17px 28px; font-size: 1.05rem; }
  .btn :global(.icon) { width: 18px; height: 18px; }
  @media (max-width: 860px) { .hero-foot { grid-template-columns: 1fr; } .hero-foot .btn-row { justify-content: flex-start; } }

  /* Hero entrance */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.hero-in)) [data-h] { opacity: 0; transform: translateY(28px); }
    [data-h] { transition: opacity .9s ease, transform .9s cubic-bezier(.2,.8,.2,1); }
    [data-h="2"] { transition-delay: .08s; } [data-h="3"] { transition-delay: .16s; } [data-h="4"] { transition-delay: .24s; } [data-h="5"] { transition-delay: .4s; }
  }

  .ticker { position: relative; z-index: 1; border-block: 1px solid var(--line); padding-block: 18px; display: flex; overflow: hidden; background: rgba(255,255,255,.015); }
  .tk-track { display: flex; flex-shrink: 0; gap: 36px; padding-right: 36px; animation: slide 40s linear infinite; }
  .tk-track span { display: inline-flex; align-items: center; gap: 36px; font-family: var(--f-display); font-weight: 700; font-size: clamp(1.1rem, .9rem + 1vw, 1.7rem); letter-spacing: -0.02em; color: var(--muted); white-space: nowrap; }
  .tk-track i { font-style: normal; color: var(--accent); font-size: .8em; }
  @keyframes slide { to { transform: translateX(-100%); } }

  /* Heads */
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 16px 40px; max-width: none; flex-wrap: wrap; }
  .head-row > div { display: grid; gap: 16px; max-width: 760px; }
  .lede.sm { font-size: var(--step-0); max-width: 42ch; }

  /* Clients */
  .clients { padding-bottom: clamp(40px, 6vw, 72px); }
  .logo-wall { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(12px, 1.6vw, 18px); }
  .logo-tile { position: relative; display: grid; grid-template-rows: 1fr auto; border-radius: var(--radius); overflow: hidden; background: var(--surface); border: 1px solid var(--line); transition: transform .4s cubic-bezier(.2,.8,.2,1), border-color .3s; }
  .logo-tile.wide { grid-column: span 2; }
  .logo-tile:hover { transform: translateY(-6px); border-color: rgba(79,209,184,.35); }
  .lt-inner { background: var(--tile); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; min-height: clamp(150px, 15vw, 200px); padding: clamp(18px, 3vw, 32px); position: relative; overflow: hidden; }
  .lt-inner::after { content: ''; position: absolute; inset: 0; background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.22) 50%, transparent 70%); transform: translateX(-120%); transition: transform .9s ease; pointer-events: none; }
  .logo-tile:hover .lt-inner::after { transform: translateX(120%); }
  .lt-inner img { max-width: min(82%, 340px); max-height: 120px; width: auto; height: auto; object-fit: contain; transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .logo-tile:hover .lt-inner img { transform: scale(1.05); }
  .lt-mark { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; font-size: 1.35rem; color: #1e4e6e; letter-spacing: -0.01em; }
  .logo-tile:not(.wide) .lt-inner img { max-height: 130px; }
  .logo-tile[style*='#ffffff'] .lt-inner img, .logo-tile[style*='#fbf7f2'] .lt-inner img { max-height: 110px; }
  .lt-cap { display: flex; justify-content: space-between; gap: 10px; padding: 12px 16px; font-size: .85rem; color: var(--muted); border-top: 1px solid var(--line); }
  .lt-cap b { color: var(--ink); font-weight: 650; }
  .lt-link { display: grid; grid-template-rows: 1fr auto; text-decoration: none; color: inherit; height: 100%; }
  .lt-go { color: var(--accent); font-weight: 700; display: inline-block; transition: transform .3s; }
  .logo-tile:hover .lt-go { transform: translate(3px, -3px); }
  .no-img .lt-inner img { display: none; }
  .no-img .lt-inner::before { content: attr(data-name); font-family: var(--f-display); font-weight: 750; font-size: 1.6rem; color: #fff; letter-spacing: -0.02em; }
  .next-tile { border-style: dashed; border-color: rgba(79,209,184,.35); background: transparent; }
  .nt-inner { display: grid; place-content: center; justify-items: center; gap: 8px; text-align: center; min-height: 100%; padding: clamp(24px, 3vw, 36px); text-decoration: none; color: var(--ink); grid-row: 1 / -1; }
