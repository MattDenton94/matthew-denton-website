---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProjectSpotlight from "@/components/ProjectSpotlight.astro";
import CtaBand from "@/components/CtaBand.astro";
import Testimonials from "@/components/Testimonials.astro";
import { getCollection } from "astro:content";
import { SITE } from "@/lib/site";
import { TESTIMONIALS } from "@/data/testimonials";

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const [primaryWork, secondaryWork] = work;

const capabilities = [
  { n: "01", label: "Look professional", copy: "Your website is often the first impression a potential customer gets of your business. It should look like it." },
  { n: "02", label: "Get found", copy: "A properly structured site gives people another way to discover your business — before they've even called." },
  { n: "03", label: "Get contacted", copy: "WhatsApp, contact forms, maps and booking links — all built around making it easy to reach you." },
  { n: "04", label: "Work with a real person", copy: "You deal directly with me, start to finish. No agency middleman." },
];

const webApps = [
  "Pricing & quote calculators",
  "Booking & scheduling",
  "Client portals",
  "Internal tools & dashboards",
];

const webAppExamples = [
  {
    src: "/images/work/webapp-budget-dashboard.jpg",
    alt: "A personal budget tracker — income, expenses, balance and savings rate, with an add-transaction form and spending by category.",
    label: "Personal budget tracker",
  },
  {
    src: "/images/work/webapp-profit-tracker-summary.jpg",
    alt: "A daily profit tracker built for Nectra's DTC store — a monthly summary table of revenue, ad spend, expenses, profit and margin.",
    label: "Nectra — profit tracker",
  },
  {
    src: "/images/work/webapp-travel-explorer.jpg",
    alt: "A travel and visa-requirement explorer, with country cards showing visa status, best time to visit and nightly rates.",
    label: "Travel & visa explorer",
  },
];

const shopifyIncluded = [
  "Shopify store setup",
  "Responsive design",
  "Product & collection setup",
  "Payment & shipping setup",
  "Essential store pages",
  "Mobile optimisation",
  "Analytics setup",
  "Launch assistance",
];

const problems = [
  "Looks outdated next to your competitors",
  "Doesn't work properly on a phone",
  "Makes it hard for someone to actually contact you",
  "Doesn't explain clearly what you do",
  "Makes a good business look smaller than it is",
];

const included = [
  "Custom design & build",
  "Mobile-optimised",
  "WhatsApp integration",
  "Contact form",
  "Google Maps",
  "Social links",
  "Analytics setup",
  "Domain connection",
];

const process = [
  { n: "01", title: "Discover", copy: "A short call about your business and your customers." },
  { n: "02", title: "Design", copy: "A real direction — type, colour, layout — before a line of code." },
  { n: "03", title: "Build", copy: "Fast, responsive, tested on real devices." },
  { n: "04", title: "Launch", copy: "Deployed, connected to your domain, handed over in plain English." },
];

const whatAGoodSiteDoes = [
  "Looks professional",
  "Explains the business clearly",
  "Works properly, on every device",
  "Makes it easy to get in touch",
];

const faqs = [
  { q: "How much does a website cost?", a: "Every project is quoted individually. What it costs depends on how many pages you need, whether you need copy written, and whether there's anything custom like a booking system or an online store. Tell me what you're after and I'll give you a fixed price before any work starts, so there are no surprises." },
  { q: "How long does it take?", a: "It depends on the scope, but I'll give you a clear timeline before any work starts." },
  { q: "Do I need to provide the content?", a: "Not necessarily — I can write the copy for you, or work with what you already have." },
  { q: "Do you provide hosting and a domain?", a: "I'll help you get set up with both, or work with what you already have." },
  { q: "Can you update my existing website?", a: "Yes — depending on what it's built on, I can update it directly, or tell you honestly if a rebuild is the better option." },
  { q: "Can I pay in instalments?", a: "Talk to me about what works for you — payment terms can usually be arranged." },
  { q: "Do you only work with South African businesses?", a: `${SITE.locationLine} If you're outside South Africa, I'm still happy to talk.` },
];
---

<BaseLayout
  title="Matthew Denton"
  description={SITE.tagline}
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-surface-border">
    <div class="container-page pb-14 pt-14 sm:pb-20 sm:pt-20 lg:pt-24">
      <p class="eyebrow animate-fade-up">{SITE.role}</p>
      <h1 class="mt-5 max-w-3xl font-display text-4xl font-semibold leading-[1.08] sm:text-6xl lg:text-[4.75rem] lg:leading-[1.05] animate-fade-up" style="animation-delay: 60ms;">
        Your business is better than your <span class="text-accent">website</span> makes it look.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-paper/75 sm:text-xl animate-fade-up" style="animation-delay: 120ms;">
        Professional websites for South African small businesses — designed to turn visitors into calls, WhatsApp messages and customers.
      </p>
      <div class="mt-8 flex flex-col gap-4 sm:flex-row animate-fade-up" style="animation-delay: 180ms;">
        <a href="/contact" class="btn-primary">
          {SITE.ctaLabel}
        </a>
        <a href="#work" class="btn-outline">
          See the work
        </a>
      </div>
      <p class="mt-7 font-mono text-xs uppercase tracking-widish text-muted animate-fade-up" style="animation-delay: 240ms;">
        {SITE.locationLine} Replies within a day.
      </p>
    </div>
  </section>

  <!-- CAPABILITIES -->
  <section class="border-b border-surface-border bg-ink-alt">
    <div class="container-page py-12 sm:py-16">
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
        {capabilities.map((c) => (
          <div class="border-t border-surface-border pt-5">
            <p class="font-mono text-xs text-accent">{c.n}</p>
            <h3 class="mt-2 font-display text-xl font-semibold">{c.label}</h3>
            <p class="mt-2 text-base leading-relaxed text-paper/70 sm:text-sm">{c.copy}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- OFFER -->
  <section class="border-b border-surface-border">
    <div class="container-page py-14 sm:py-20">
      <p class="eyebrow">What's included</p>
      <h2 class="mt-3 max-w-lg text-3xl font-semibold sm:text-4xl">Everything a small business actually needs.</h2>

      <ul class="mt-8 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
        {included.map((item) => (
          <li class="flex items-start gap-3 text-lg text-paper/85">
            <span class="mt-2.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-9">
        <a href="/contact" class="btn-primary">{SITE.ctaLabel}</a>
      </div>
      <p class="mt-2 text-sm text-muted">{SITE.pricingLine}</p>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="border-b border-surface-border bg-ink-alt">
    <div class="container-page py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <p class="eyebrow">The problem</p>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Does your website actually help your business?</h2>
        </div>
        <div>
          <p class="text-lg leading-relaxed text-paper/75">
            A lot of small business websites quietly work against the business behind them. Yours might be one of them if it:
          </p>
          <ul class="mt-5 space-y-3">
            {problems.map((item) => (
              <li class="flex items-start gap-3 text-lg text-paper/85">
                <span class="mt-2.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="mt-5 text-lg font-semibold text-paper">That's what I fix.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIO — the visual centre of the page -->
  <section id="work" class="scroll-mt-20 border-b border-surface-border">
    <div class="container-page py-16 sm:py-24">
      <div class="mb-12 flex items-end justify-between gap-6 sm:mb-16">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="mt-3 text-4xl font-semibold sm:text-5xl">Real sites, for real businesses.</h2>
          <p class="mt-4 max-w-xl text-base text-paper/70 sm:text-lg">
            Recent work has been heavy on fitness: gyms, studios and coaches. If that's you, there's a page <a href="/gyms" class="link-underline text-paper/85">specifically for that</a>.
          </p>
        </div>
        <a href="/work" class="btn-ghost hidden sm:inline-flex">All work</a>
      </div>

      <div class="space-y-20 sm:space-y-24">
        {primaryWork && <ProjectSpotlight entry={primaryWork} variant="bleed" index={1} />}
        {secondaryWork && <ProjectSpotlight entry={secondaryWork} variant="framed" index={2} />}
      </div>

      <a href="/work" class="btn-outline mt-14 inline-flex sm:hidden">All work</a>
    </div>
  </section>

  <Testimonials testimonials={TESTIMONIALS} />

  <!-- SHOPIFY ECOMMERCE — secondary service -->
  <section class="border-b border-surface-border bg-ink-alt">
    <div class="container-page py-14 sm:py-20">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-start lg:gap-20">
        <div>
          <p class="eyebrow">Shopify ecommerce</p>
          <h2 class="mt-3 text-3xl font-semibold sm:text-4xl">Need an online store?</h2>
          <p class="mt-4 text-lg leading-relaxed text-paper/75">
            I can build you a clean, professional Shopify store — easy for customers to browse, buy and pay on, without the cost of a huge ecommerce project.
          </p>

          <a
            href="/work/nectra"
            class="mt-6 flex items-center gap-4 rounded-xl border border-surface-border bg-surface p-3 transition-colors hover:border-accent/60"
          >
            <img
              src="/images/work/nectra-hero.jpg"
              alt=""
              loading="lazy"
              class="h-14 w-20 flex-shrink-0 rounded-lg object-cover object-top"
            />
            <span>
              <span class="block font-display text-base font-semibold text-paper">Nectra — built on Shopify</span>
              <span class="block text-sm text-muted">See the store &rarr;</span>
            </span>
          </a>

          <p class="mt-4 text-base text-paper/70">
            Need something more custom instead? I also build fully bespoke websites — <a href="#work" class="link-underline text-paper/80">see the work</a>.
          </p>
        </div>

        <div class="card p-6 sm:p-8">
          <ul class="grid gap-x-6 gap-y-3 sm:grid-cols-2">
            {shopifyIncluded.map((item) => (
              <li class="flex items-start gap-3 text-base text-paper/85">
                <span class="mt-2 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
                {item}
              </li>
            ))}
          </ul>

          <a href="/contact" class="btn-primary mt-7 inline-flex">Start your Shopify store</a>

          <p class="mt-4 text-xs text-muted">
            Shopify's own subscription, payment fees, your domain and any paid themes/apps aren't included — I'll help you set those up, but they're billed directly by Shopify.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WEB APPLICATIONS — secondary service -->
  <section class="border-b border-surface-border">
    <div class="container-page py-14 sm:py-20">
      <p class="eyebrow">Web applications</p>
      <h2 class="mt-3 max-w-lg text-3xl font-semibold sm:text-4xl">Sometimes you need more than a website.</h2>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-paper/75">
        Some businesses need something a website alone can't do — a quote calculator, a booking system, a client portal, a simple internal tool. I build small, focused web applications too — no unnecessary complexity, just something that works.
      </p>

      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        {webAppExamples.map((ex) => (
          <div class="overflow-hidden rounded-xl border border-surface-border bg-surface">
            <img src={ex.src} alt={ex.alt} loading="lazy" class="aspect-[4/3] w-full object-cover object-top" />
            <p class="p-3 text-sm font-semibold text-paper">{ex.label}</p>
          </div>
        ))}
      </div>

      <ul class="mt-6 flex flex-wrap gap-2">
        {webApps.map((item) => (
          <li class="rounded-full border border-surface-border px-3 py-1 font-mono text-[0.65rem] uppercase tracking-widish text-muted">
            {item}
          </li>
        ))}
      </ul>

      <div class="mt-9">
        <a href="/contact" class="btn-primary">Let's scope your project</a>
      </div>
      <p class="mt-2 text-sm text-muted">
        Scope varies a lot, so every application is quoted after a short conversation about what it needs to do.
      </p>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="border-b border-surface-border bg-ink-alt">
    <div class="container-page py-14 sm:py-20">
      <p class="eyebrow">How it works</p>
      <h2 class="mt-3 max-w-lg text-3xl font-semibold sm:text-4xl">Four stages. No surprises.</h2>

      <div class="mt-10 grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-4">
        {process.map((step) => (
          <div class="flex gap-4 lg:flex-col lg:gap-3">
            <span class="font-display text-2xl font-semibold text-accent">{step.n}</span>
            <div>
              <h3 class="font-display text-lg font-semibold">{step.title}</h3>
              <p class="mt-1 max-w-xs text-base leading-relaxed text-paper/70 sm:text-sm">{step.copy}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- HOW I WORK -->
  <section class="border-b border-surface-border">
    <div class="container-page py-16 sm:py-24">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20">
        <div>
          <p class="eyebrow">How I work</p>
          <h2 class="mt-3 text-4xl font-semibold sm:text-5xl">No templates. No jargon. No bloat.</h2>
        </div>
        <div class="space-y-6">
          <p class="text-lg leading-relaxed text-paper/75">
            Most small businesses don't need a giant agency process — a discovery workshop, a stakeholder deck, a team of six. They need a website that:
          </p>
          <ul class="space-y-3">
            {whatAGoodSiteDoes.map((item) => (
              <li class="flex items-start gap-3 text-lg text-paper/85">
                <span class="mt-2.5 h-1.5 w-1.5 flex-shrink-0 rounded-full bg-accent"></span>
                {item}
              </li>
            ))}
          </ul>
          <p class="text-lg font-semibold text-paper">
            I build that.
          </p>
          <p class="text-base text-paper/70">
            You talk to me. I build it — no hand-offs, no account manager, no agency theatre.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-b border-surface-border bg-ink-alt">
    <div class="container-page py-14 sm:py-20">
      <p class="eyebrow">Common questions</p>
      <h2 class="mt-3 max-w-lg text-3xl font-semibold sm:text-4xl">Before you ask.</h2>

      <div class="mt-8 divide-y divide-surface-border border-t border-surface-border sm:mt-10">
        {faqs.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-semibold text-paper marker:content-none">
              {item.q}
              <span class="flex-shrink-0 text-2xl leading-none text-accent transition-transform group-open:rotate-45">+</span>
            </summary>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-paper/75">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
