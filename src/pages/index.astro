---
import Base from '../layouts/Base.astro';
import CrmBoard from '../components/CrmBoard.astro';
import Phone from '../components/Phone.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { pains, system, metrics, projects, faqs } from '../data/site';

const harlan = projects.find((p) => p.slug === 'harlan')!;
const others = projects.filter((p) => p.slug !== 'harlan');
---
<Base title="Matthew Denton | More booked consults for aesthetic clinics">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">For aesthetic and skin clinics</p>
        <h1>Turn every enquiry into a booked consult.</h1>
        <p class="lede">Meta ads, UGC, a website and a CRM built for your clinic, working as one system. Every enquiry gets an answer in seconds, a consult in the diary, and a reminder when the next treatment is due.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/contact">Get the free audit</a>
          <a class="btn btn-ghost" href="#system">See how it works</a>
        </div>
        <p class="hero-note">The audit shows you where bookings slip away today. It's free, and yours to keep.</p>
      </div>
      <CrmBoard />
    </div>
  </section>

  <!-- PAINS -->
  <section class="section pains">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Sound familiar?</p>
        <h2>Most clinics don't have a lead problem. They have a follow-up problem.</h2>
        <p class="lede">The enquiries are coming in. They're just leaking out between the first message and the second treatment.</p>
      </div>
      <ul class="pain-list">
        {pains.map((p) => (
          <li class="pain">
            <div class="thread" aria-hidden="true">
              <span class="bubble">{p.msg}</span>
              <span class="stamp num">{p.time}</span>
              <span class="status">{p.status}</span>
            </div>
            <p>{p.point}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SYSTEM -->
  <section class="section system" id="system">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">The system</p>
        <h2>One system, from first scroll to second treatment.</h2>
        <p class="lede">Four parts built to work together, so nothing falls between your ads, your inbox and your diary.</p>
      </div>
      <ol class="steps">
        {system.map((s, i) => (
          <li>
            <span class="step-n num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
            <ul>{s.items.map((it) => <li>{it}</li>)}</ul>
          </li>
        ))}
      </ol>
      <p class="more"><a href="/services">How each part works</a></p>
    </div>
  </section>

  <!-- REPORT -->
  <section class="section report">
    <div class="wrap"><div class="report-grid">
      <div class="head" style="margin:0">
        <p class="eyebrow">How you'll know it's working</p>
        <h2>Judged on bookings, not likes.</h2>
        <p class="lede">Every month you get the numbers that decide whether your chairs are full, pulled straight from your CRM.</p>
      </div>
      <dl class="metrics">
        {metrics.map((m) => (<div><dt>{m.name}</dt><dd>{m.note}</dd></div>))}
      </dl>
    </div></div>
  </section>

  <!-- WHY ME -->
  <section class="section why">
    <div class="wrap why-grid">
      <div class="why-copy">
        <img class="why-photo" src="/matt.webp" alt="Matthew Denton" width="720" height="960" loading="lazy" />
        <p class="eyebrow">Why me</p>
        <h2>I've worked in healthcare. I know what it means when a client trusts you with their face.</h2>
      </div>
      <div class="why-body">
        <p>Before this I spent four years as an Advanced Life Support paramedic. I understand clinical language, consent and patient trust, and why a clinic can't promise results in an ad. I'll never write anything you'd be uncomfortable putting your name to.</p>
        <p>I also run my own brand, <a href="/work/harlan">Harlan</a>. Every ad tactic I'd use for your clinic has been tested with my own money first.</p>
        <p>And you deal with me directly. No account managers and no handovers. The person who builds your system is the person who answers your message.</p>
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="section work" id="work">
    <div class="wrap">
      <div class="head head-row">
        <div>
          <p class="eyebrow">Work</p>
          <h2>Built for businesses that sell on trust.</h2>
        </div>
        <a class="btn btn-ghost" href="/work">All work</a>
      </div>
      <a class="feature" href="/work/harlan">
        <div class="feature-copy">
          <span class="tag">My own brand</span>
          <h3>{harlan.name}</h3>
          <p>{harlan.summary}</p>
          <p class="lesson">{harlan.lesson}</p>
          <span class="link">How I built Harlan</span>
        </div>
        <div class="feature-shots">
          {harlan.shots.slice(0, 2).map((sh, i) => <Phone src={sh.src} alt={sh.alt} crop class={`fs fs${i}`} />)}
        </div>
      </a>
      <div class="work-grid">
        {others.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="wrap faq-grid">
      <div class="head">
        <p class="eyebrow">Questions</p>
        <h2>Good to know</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  /* Background: the clinic treatment room photo sits on the right and fades into the page on the left,
     so the headline stays clean and the room shows behind the CRM board. */
  .hero {
    padding-block: clamp(36px, 6vw, 88px) clamp(56px, 7vw, 104px);
    background:
      linear-gradient(180deg, transparent 75%, var(--bg) 100%),
      linear-gradient(90deg, var(--bg) 0%, var(--bg) 43%, color-mix(in srgb, var(--bg) 72%, transparent) 54%, color-mix(in srgb, var(--bg) 20%, transparent) 74%, transparent 100%),
      url('/clinic-room.webp') right 0 top 22% / 58% auto no-repeat,
      var(--bg);
  }
  @media (max-width: 960px) {
    .hero {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--bg) 78%, transparent) 0%, color-mix(in srgb, var(--bg) 92%, transparent) 50%, var(--bg) 100%),
        url('/clinic-room-sm.webp') 20% 80% / cover no-repeat,
        var(--bg);
    }
  }
  .hero-grid { display: grid; grid-template-columns: 1fr 1.08fr; gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hero-copy { display: grid; gap: 22px; }
  h1 { font-size: var(--step-4); font-weight: 750; letter-spacing: -0.035em; max-width: 13ch; }
  .hero-note { font-size: .9rem; color: var(--muted); max-width: 44ch; }
  @media (max-width: 960px) { .hero-grid { grid-template-columns: 1fr; } }

  /* Pains */
  .pains { background: var(--surface); border-block: 1px solid var(--line); }
  .pain-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(28px, 4vw, 56px) clamp(24px, 4vw, 64px); }
  .pain { display: grid; gap: 14px; align-content: start; }
  .thread { display: grid; grid-template-columns: auto 1fr; align-items: end; gap: 6px 10px; justify-items: start; }
  .bubble { background: var(--bg); border: 1px solid var(--line); border-radius: 18px 18px 18px 4px; padding: 10px 14px; font-weight: 550; max-width: 30ch; }
  .stamp { font-size: .78rem; color: var(--muted); padding-bottom: 4px; }
  .status { grid-column: 1 / -1; font-size: .85rem; font-weight: 650; color: var(--blush-ink); background: var(--blush); border-radius: 999px; padding: 3px 10px; }
  .pain p { color: var(--muted); max-width: 52ch; }
  @media (max-width: 760px) { .pain-list { grid-template-columns: 1fr; } }

  /* System */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 32px); }
  .steps > li { display: grid; gap: 12px; align-content: start; border-top: 2px solid var(--ink); padding-top: 18px; }
  .step-n { width: 30px; height: 30px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; font-weight: 700; font-size: .9rem; }
  .steps h3 { font-size: var(--step-1); letter-spacing: -0.02em; }
  .steps p { color: var(--muted); }
  .steps ul { list-style: none; margin: 4px 0 0; padding: 0; display: grid; gap: 6px; font-size: .95rem; }
  .steps ul li { padding-left: 16px; position: relative; }
  .steps ul li::before { content: ''; position: absolute; left: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .more { margin-top: 28px; }
  .more a { font-weight: 650; color: var(--accent); }
  @media (max-width: 1000px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .steps { grid-template-columns: 1fr; } }

  /* Report */
  .report { padding-top: 0; }
  .report-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 5vw, 72px); align-items: start; background: var(--accent-soft); border-radius: var(--radius); padding: clamp(24px, 5vw, 64px); }
  .report h2 { color: var(--ink); }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 28px; }
  .metrics div { border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent); padding-block: 14px 18px; }
  .metrics dt { font-family: var(--f-display); font-weight: 700; font-size: 1.15rem; letter-spacing: -0.015em; }
  .metrics dd { margin: 2px 0 0; color: var(--muted); font-size: .95rem; }
  @media (max-width: 900px) { .report-grid { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .metrics { grid-template-columns: 1fr; } }

  /* Why */
  .why { background: #f2ebe5; border-block: 1px solid #e6dcd4; }
  .why-grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .why-copy { display: grid; gap: 16px; justify-items: start; }
  .why-photo { width: 112px; height: 112px; border-radius: 50%; object-fit: cover; object-position: center 22%; margin-bottom: 8px; }
  .why h2 { font-size: var(--step-3); }
  .why-body { display: grid; gap: 18px; color: #5e534e; font-size: var(--step-1); line-height: 1.5; }
  .why-body a { color: var(--ink); }
  @media (max-width: 860px) { .why-grid { grid-template-columns: 1fr; } }

  /* Work */
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 16px; max-width: none; flex-wrap: wrap; }
  .head-row > div { display: grid; gap: 16px; max-width: 760px; }
  .feature { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 4vw, 56px); align-items: center; text-decoration: none; background: #f4ece6; color: #3f3330; border-radius: var(--radius); padding: clamp(24px, 4vw, 56px); margin-bottom: clamp(40px, 5vw, 64px); overflow: hidden; }
  .feature-copy { display: grid; gap: 14px; justify-items: start; }
  .feature h3 { font-size: var(--step-3); color: #3f3330; }
  .feature p { color: #6b5a55; max-width: 46ch; }
  .feature .lesson { color: #3f3330; font-weight: 600; }
  .tag { font-size: .82rem; font-weight: 650; padding: 4px 10px; border-radius: 999px; background: #a5676b; color: #fff; }
  .link { font-weight: 650; text-decoration: underline; text-underline-offset: 4px; }
  .feature-shots { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 2vw, 24px); align-items: start; }
  .feature-shots :global(.fs1) { margin-top: 36px; }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 40px); }
  @media (max-width: 860px) { .feature { grid-template-columns: 1fr; } }
  @media (max-width: 960px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .work-grid { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq { padding-top: 0; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 20px 40px 20px 0; font-family: var(--f-display); font-weight: 650; font-size: var(--step-1); letter-spacing: -0.015em; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; translate: 0 -50%; font-size: 1.4rem; color: var(--accent); transition: rotate .2s ease; }
  details[open] summary::after { rotate: 45deg; }
  details p { color: var(--muted); padding-bottom: 22px; max-width: 62ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
