---
import Base from '../layouts/Base.astro';
import Mockup from '../components/Mockup.astro';
import Phone from '../components/Phone.astro';
import Post from '../components/Post.astro';
import Desktop from '../components/Desktop.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CtaBand from '../components/CtaBand.astro';
import WaIcon from '../components/WaIcon.astro';
import { services, projects, clients, faqs, tools, wa } from '../data/site';

const harlan = projects.find((p) => p.slug === 'harlan')!;
const grid = projects.filter((p) => ['creative-pearls', 'tnt-fitness', 'nafts'].includes(p.slug));
const steps = [
  { t: 'Talk', d: "A quick call or WhatsApp chat about your business, your customers and what's getting in the way." },
  { t: 'Plan', d: 'A clear scope, price and timeline in writing. You see the direction before anything gets built.' },
  { t: 'Build', d: 'I design, build and set things up, sharing progress as I go so there are no surprises.' },
  { t: 'Launch and grow', d: 'We go live, I show you how it works, and I stay on hand for changes, ads and new ideas.' },
];
---
<Base title="Matthew Denton | Websites, stores, ads and automations for small businesses">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">One-person studio · Cape Town · Clients anywhere</p>
        <h1>Your business is <span class="mark">better</span> than your website makes it look.</h1>
        <p class="lede">I'm Matt. I build websites and Shopify stores, run your ads, design your brand in Canva and set up AI automations, so small businesses look as good online as they are in real life.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={wa()} target="_blank" rel="noopener"><WaIcon /> WhatsApp me</a>
          <a class="btn btn-ghost" href="/work">See the work</a>
        </div>
        <p class="hero-note mono">Replies within a day · Quotes are free</p>
      </div>
      <div class="stack" aria-label="Recent projects">
        <a href="/work/tnt-fitness" class="s s3" aria-label="TNT Fitness website"><Desktop src="/work/tnt-schedule.webp" alt="TNT Fitness weekly schedule" eager /></a>
        <a href="/work/creative-pearls" class="s s2" aria-label="Creative Pearls website"><Phone src="/work/pearls-home.webp" alt="Creative Pearls homepage on a phone" crop eager /></a>
        <a href="/work/harlan" class="s s1" aria-label="Harlan store"><Phone src="/work/harlan-home.webp" alt="Harlan homepage on a phone" crop eager /></a>
        <a href="/work/harlan" class="s s4" aria-label="Harlan Meta ad"><Post src="/work/harlan-ad.webp" alt="Harlan Meta ad: Payday. Treat the wrist." label="Ad I designed" eager /></a>
        <span class="stack-tag mono">Harlan, my own store <span aria-hidden="true">↗</span></span>
      </div>
    </div>
  </section>

  <!-- CLIENT STRIP -->
  <section class="strip" aria-label="Clients">
    <div class="wrap strip-inner">
      <span class="eyebrow">Working with</span>
      <ul>{clients.map((c) => <li>{c}</li>)}</ul>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section" id="services">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">What I do</p>
        <h2>Everything a small business needs online, from one person you can actually reach.</h2>
        <p class="lede">No agency hand-offs and no juggling four freelancers. Start with one thing, add the rest when you're ready.</p>
      </div>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc" id={s.slug}>
            <div class="svc-top"><span class={`grp grp-${s.group.toLowerCase()}`}>{s.group}</span></div>
            <h3>{s.title}</h3>
            <p>{s.line}</p>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="svc-more"><a href="/services">More on each service <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- HARLAN FEATURE -->
  <section class="own">
    <div class="wrap own-grid">
      <div class="own-copy">
        <p class="eyebrow on-band">My own brand</p>
        <h2>I don't just build stores. I run one.</h2>
        <p>{harlan.summary}</p>
        <dl class="own-facts">
          {harlan.facts.map((f) => (<div><dt>{f.label}</dt><dd>{f.value}</dd></div>))}
        </dl>
        <div class="btn-row">
          <a class="btn btn-light" href="/work/harlan">How I built Harlan</a>
          <a class="btn btn-line" href="https://harlan.co.za" target="_blank" rel="noopener">Visit harlan.co.za <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="own-visual">
        <Phone src="/work/harlan-home.webp" alt="Harlan homepage on a phone" crop class="ov-phone" />
        <Post src="/work/harlan-ad.webp" alt="Harlan Meta ad: Payday. Treat the wrist. Second bracelet half price." label="Meta ad" class="ov-post" />
      </div>
    </div>
  </section>

  <!-- WORK -->
  <section class="section" id="work">
    <div class="wrap">
      <div class="head head-row">
        <div>
          <p class="eyebrow">Client work</p>
          <h2>Recent projects</h2>
        </div>
        <a class="btn btn-ghost" href="/work">All work</a>
      </div>
      <div class="work-grid">
        {grid.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>

  <!-- TOOLS -->
  <section class="section-tight tools">
    <div class="wrap tools-grid">
      <div class="head" style="margin:0">
        <p class="eyebrow">Tools and automations</p>
        <h2>If you do it every week, it can probably run itself.</h2>
        <p class="lede">Before web work I led teams in AI data operations, so automations and small web tools are home ground. A few I've built:</p>
      </div>
      <ul class="tool-list">
        {tools.map((t) => (<li><strong>{t.name}</strong><span>{t.line}</span></li>))}
        <li class="tool-ask"><strong>Your turn</strong><span>Tell me the task that eats your week. I'll tell you if it can be automated, and roughly what it would take.</span></li>
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">How it works</p>
        <h2>Simple, in four steps.</h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="num mono">{String(i + 1).padStart(2, '0')}</span><h3>{s.t}</h3><p>{s.d}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq">
    <div class="wrap faq-grid">
      <div class="head">
        <p class="eyebrow">Questions</p>
        <h2>Good to know</h2>
      </div>
      <div class="faq-list">
        {faqs.map((f) => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(40px, 6vw, 88px) clamp(56px, 7vw, 100px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero-copy { display: grid; gap: 24px; }
  h1 { font-size: var(--step-4); font-weight: 750; letter-spacing: -0.028em; font-variation-settings: 'opsz' 72; }
  .hero-note { font-size: .8rem; color: var(--muted); }

  .stack { position: relative; aspect-ratio: 1 / 0.95; max-width: 100%; }
  .s { text-decoration: none; position: absolute; display: block; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .s3 { left: 0; top: 4%; width: 66%; transform: rotate(-4deg); z-index: 1; }
  .s2 { left: 10%; top: 26%; width: 30%; transform: rotate(-5deg); z-index: 2; }
  .s1 { right: 4%; top: 0; width: 34%; transform: rotate(3deg); z-index: 3; }
  .s4 { left: 38%; bottom: 0; width: 32%; transform: rotate(-2deg); z-index: 4; }
  .stack:hover .s1 { transform: rotate(5deg) translate(4%, -2%); }
  .stack:hover .s2 { transform: rotate(-8deg) translate(-6%, 2%); }
  .stack:hover .s3 { transform: rotate(-6deg) translate(-3%, -4%); }
  .stack:hover .s4 { transform: rotate(0deg) translate(2%, 3%); }
  .stack-tag { position: absolute; right: 0; bottom: 14%; z-index: 5; font-size: .75rem; background: var(--mark); color: var(--mark-ink); padding: 5px 10px; border-radius: 6px; transform: rotate(-2deg); }
  @media (prefers-reduced-motion: no-preference) {
    .s { animation: deal .9s cubic-bezier(.2,.7,.2,1) both; }
    .s2 { animation-delay: .1s; }
    .s1 { animation-delay: .2s; }
    .s4 { animation-delay: .3s; }
    @keyframes deal { from { translate: 0 40px; opacity: 0.001; } to { translate: 0 0; opacity: 1; } }
  }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .stack { max-width: 560px; width: 100%; margin-inline: auto; }
  }

  /* Strip */
  .strip { border-block: 1px solid var(--line); }
  .strip-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; padding-block: 20px; }
  .strip ul { display: flex; flex-wrap: wrap; gap: 8px 32px; list-style: none; margin: 0; padding: 0; font-family: var(--f-display); font-weight: 600; font-size: 1.15rem; letter-spacing: -0.01em; }

  /* Services */
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .svc { background: var(--surface); padding: clamp(22px, 3vw, 34px); display: grid; gap: 12px; align-content: start; }
  .svc h3 { font-size: var(--step-2); }
  .svc p { color: var(--muted); }
  .svc ul { list-style: none; padding: 0; margin: 6px 0 0; display: grid; gap: 6px; font-size: .95rem; }
  .svc li { padding-left: 18px; position: relative; }
  .svc li::before { content: ''; position: absolute; left: 0; top: .62em; width: 8px; height: 2px; background: var(--accent); }
  .grp { font-family: var(--f-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; padding: 3px 8px; border-radius: 5px; }
  .grp-build { background: var(--accent-soft); color: var(--accent); }
  .grp-grow { background: var(--mark); color: var(--mark-ink); }
  .grp-automate { background: var(--ink); color: var(--bg); }
  .svc-more { margin-top: 20px; }
  .svc-more a { font-weight: 650; color: var(--accent); text-decoration: none; }
  .svc-more a:hover { text-decoration: underline; }
  @media (max-width: 960px) { .svc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .svc-grid { grid-template-columns: 1fr; } }

  /* Own brand */
  .own { background: var(--band); color: var(--band-ink); padding-block: clamp(64px, 9vw, 120px); }
  .own-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .own-copy { display: grid; gap: 22px; }
  .own h2 { font-size: var(--step-3); }
  .own p { color: var(--band-muted); max-width: 48ch; }
  .on-band { color: var(--band-muted); }
  .own-facts { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 24px; margin: 4px 0; }
  .own-facts div { border-top: 1px solid color-mix(in srgb, var(--band-ink) 18%, transparent); padding-top: 10px; }
  .own-facts dt { font-family: var(--f-mono); font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; color: var(--band-muted); }
  .own-facts dd { margin: 2px 0 0; font-family: var(--f-display); font-size: 1.25rem; font-weight: 600; }
  .btn-light { background: var(--band-ink); color: var(--band); }
  .btn-line { border-color: color-mix(in srgb, var(--band-ink) 30%, transparent); color: var(--band-ink); }
  .btn-line:hover { border-color: var(--band-ink); }
  .own-visual { display: grid; grid-template-columns: 0.8fr 1fr; gap: clamp(16px, 3vw, 32px); align-items: center; }
  .own-visual :global(.ov-phone) { transform: rotate(-2deg); }
  .own-visual :global(.ov-post) { transform: rotate(2deg) translateY(24px); }
  @media (max-width: 900px) { .own-grid { grid-template-columns: 1fr; } }

  /* Work */
  .head-row { display: flex; justify-content: space-between; align-items: end; gap: 16px; max-width: none; flex-wrap: wrap; }
  .head-row > div { display: grid; gap: 16px; }
  .work-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 40px); }
  @media (max-width: 960px) { .work-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .work-grid { grid-template-columns: 1fr; } }

  /* Tools */
  .tools { background: var(--surface); border-block: 1px solid var(--line); }
  .tools-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: start; }
  .tools h2 { font-size: var(--step-3); }
  .tool-list { list-style: none; margin: 0; padding: 0; display: grid; }
  .tool-list li { display: grid; gap: 4px; padding-block: 18px; border-bottom: 1px solid var(--line); }
  .tool-list li:first-child { padding-top: 0; }
  .tool-list strong { font-family: var(--f-display); font-size: 1.3rem; font-weight: 650; letter-spacing: -0.015em; }
  .tool-list span { color: var(--muted); }
  .tool-ask strong { color: var(--accent); }
  .tool-ask { border-bottom: 0 !important; }
  @media (max-width: 860px) { .tools-grid { grid-template-columns: 1fr; } }

  /* Process */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(20px, 3vw, 36px); counter-reset: s; }
  .steps li { display: grid; gap: 10px; align-content: start; border-top: 2px solid var(--ink); padding-top: 18px; }
  .num { color: var(--accent); font-size: .85rem; }
  .steps h3 { font-size: var(--step-1); }
  .steps p { color: var(--muted); }
  @media (max-width: 900px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .steps { grid-template-columns: 1fr; } }

  /* FAQ */
  .faq { padding-top: 0; }
  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 20px 40px 20px 0; font-family: var(--f-display); font-weight: 600; font-size: var(--step-1); letter-spacing: -0.015em; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 50%; translate: 0 -50%; font-family: var(--f-mono); font-size: 1.3rem; color: var(--accent); transition: rotate .2s ease; }
  details[open] summary::after { rotate: 45deg; }
  details p { color: var(--muted); padding-bottom: 22px; max-width: 62ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
