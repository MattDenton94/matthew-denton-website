---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE, waLink } from "@/lib/site";
---

<BaseLayout
  title="Contact"
  description="Start a website project — message on WhatsApp, send an email, or use the form."
  hideWhatsAppFloat
>
  <section class="border-b border-surface-border">
    <div class="container-page py-12 sm:py-16">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-3 max-w-2xl text-4xl font-semibold sm:text-5xl lg:text-6xl">
        Tell me about the business, not just the website.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-paper/75">
        The more I understand about what you do and who you're trying to reach, the faster I can tell you honestly whether — and how — I can help.
      </p>
    </div>
  </section>

  <section class="border-b border-surface-border bg-ink-alt">
    <div class="container-page grid gap-14 py-14 sm:py-16 lg:grid-cols-[1.15fr_0.85fr] lg:gap-20">
      <div class="card order-2 p-6 sm:p-10 lg:order-1">
        <h2 class="font-display text-2xl font-semibold">{SITE.ctaLabel}</h2>
        <p class="mt-2 text-base text-paper/70">
          This opens a pre-filled email in your own mail app — nothing is sent through this website.
        </p>

        <form id="contact-form" class="mt-8 space-y-6" novalidate>
          <div class="grid gap-6 sm:grid-cols-2">
            <div>
              <label for="name" class="font-mono text-xs uppercase tracking-label text-muted">Name</label>
              <input id="name" name="name" type="text" required autocomplete="name"
                class="mt-2 w-full rounded-lg border border-surface-border bg-ink px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none" />
            </div>
            <div>
              <label for="email" class="font-mono text-xs uppercase tracking-label text-muted">Email</label>
              <input id="email" name="email" type="email" required autocomplete="email"
                class="mt-2 w-full rounded-lg border border-surface-border bg-ink px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none" />
            </div>
          </div>

          <div>
            <label for="business" class="font-mono text-xs uppercase tracking-label text-muted">Business name</label>
            <input id="business" name="business" type="text" autocomplete="organization"
              class="mt-2 w-full rounded-lg border border-surface-border bg-ink px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none" />
          </div>

          <div>
            <label for="message" class="font-mono text-xs uppercase tracking-label text-muted">What do you need?</label>
            <textarea id="message" name="message" rows="5" required
              placeholder="What your business does, what the site needs to achieve, and any deadline."
              class="mt-2 w-full rounded-lg border border-surface-border bg-ink px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none"></textarea>
          </div>

          <button type="submit" class="btn-primary w-full sm:w-auto">
            Send
          </button>
          <p id="form-fallback" class="hidden text-sm text-accent" role="status"></p>
        </form>
      </div>

      <div class="order-1 space-y-8 lg:order-2">
        <div>
          <p class="eyebrow">Prefer to talk directly?</p>
          <a href={`mailto:${SITE.email}`} class="mt-3 block font-display text-xl font-semibold text-paper hover:text-accent">
            {SITE.email}
          </a>
          <a href={waLink("Hi Matthew, I'd like to talk about a website.")} class="mt-2 block text-base text-paper/70 hover:text-accent">
            or message on WhatsApp
          </a>
        </div>
        <div>
          <p class="eyebrow">Availability</p>
          <p class="mt-3 text-base text-paper/80">{SITE.locationLine}</p>
        </div>
        <div>
          <p class="eyebrow">Pricing</p>
          <p class="mt-3 text-base text-paper/80">{SITE.pricingLine}</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ email: SITE.email }}>
  const form = document.getElementById("contact-form");
  const fallback = document.getElementById("form-fallback");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const senderEmail = String(data.get("email") || "").trim();
    const business = String(data.get("business") || "").trim();
    const message = String(data.get("message") || "").trim();

    if (!name || !senderEmail || !message) {
      if (fallback) {
        fallback.textContent = "Please fill in your name, email and a short message.";
        fallback.classList.remove("hidden");
      }
      return;
    }

    const subject = `New project enquiry from ${name}`;
    const bodyLines = [
      business && `Business: ${business}`,
      `Reply-to: ${senderEmail}`,
      "",
      message,
    ].filter(Boolean);

    const mailto = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(bodyLines.join("\n"))}`;
    window.location.href = mailto;

    if (fallback) {
      fallback.textContent = "Opening your email app… if nothing happens, email me directly instead.";
      fallback.classList.remove("hidden");
    }
  });
</script>
