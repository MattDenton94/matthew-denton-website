---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/site';
---
<Base title="Work | Matthew Denton" description="Harlan, Creative Pearls, TNT Fitness and Nautical Aerial & Fitness: booking flows, websites and ads for businesses that sell on trust.">
  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Work</p>
        <h1>Built for businesses that sell on trust.</h1>
        <p class="lede">My own brand, and clients in beauty and wellness. Different products, same job: make a stranger comfortable enough to book.</p>
      </div>
      <div class="grid">
        {projects.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  h1 { font-size: var(--step-4); max-width: 16ch; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
