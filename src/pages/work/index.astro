---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects } from '../../data/site';
---
<Base title="Work | Matthew Denton" description="Websites, booking flows, branding and ads for Harlan, Creative Pearls, TNT Fitness, Nautical Aerial & Fitness and more.">
  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Work</p>
        <h1>Recent work.</h1>
        <p class="lede">My own brand and clients across fitness, jewellery and more. Different businesses, same job: look the part and turn visitors into customers.</p>
      </div>
      <div class="grid">
        {projects.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  h1 { font-size: var(--step-4); max-width: 16ch; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
</style>
