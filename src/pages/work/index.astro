---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { projects, tools } from '../../data/site';
---
<Base title="Work | Matthew Denton" description="Stores, websites, brands and ads: Harlan, Creative Pearls, TNT Fitness, Nautical Aerial & Fitness and Nectra.">
  <section class="section">
    <div class="wrap">
      <div class="head">
        <p class="eyebrow">Work</p>
        <h1>Stores I run, and sites and ads I've built for clients.</h1>
        <p class="lede">Two of these are my own brands. The rest are local businesses I've worked with directly, no middlemen.</p>
      </div>
      <div class="grid">
        {projects.map((p) => <ProjectCard p={p} />)}
      </div>
    </div>
  </section>
  <section class="section-tight tools">
    <div class="wrap">
      <div class="head"><p class="eyebrow">Tools</p><h2>Small web apps</h2></div>
      <ul class="tl">{tools.map((t) => <li><strong>{t.name}</strong><span>{t.line}</span></li>)}</ul>
    </div>
  </section>
  <CtaBand title="Want something like this for your business?" />
</Base>
<style>
  h1 { font-size: var(--step-4); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(32px, 4vw, 56px) clamp(24px, 3vw, 40px); }
  @media (max-width: 720px) { .grid { grid-template-columns: 1fr; } }
  .tools { background: var(--surface); border-block: 1px solid var(--line); }
  .tl { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .tl li { display: grid; gap: 6px; border-top: 2px solid var(--ink); padding-top: 14px; }
  .tl strong { font-family: var(--f-display); font-size: 1.3rem; }
  .tl span { color: var(--muted); }
  @media (max-width: 720px) { .tl { grid-template-columns: 1fr; } }
</style>
