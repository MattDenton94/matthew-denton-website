---
// Ad landing page: where people land after clicking a Meta ad.
// Built to replace Facebook instant forms with a qualifying application.
import Base from '../layouts/Base.astro';
import WaIcon from '../components/WaIcon.astro';
import { contact, clients, stats, CRM_INTAKE } from '../data/site';

// Paste your Meta Pixel ID here (Events Manager > Data sources). Leave empty to skip tracking.
const PIXEL_ID = '1028847063594072';

const proof = clients.slice(0, 7);
const types = ['Salon or beauty', 'Clinic', 'Gym or fitness', 'Food or café', 'Online store', 'Events', 'Trades or services', 'Other'];
const needs = ['Website', 'Booking system', 'Online store', 'CRM', 'Logo and branding'];
const faqs = [
  { q: 'What do I get for R5,000?', a: 'A custom website built for your business, plus your Meta ads set up and run for you: ad account, pixel, ad copy and your first campaign. After that you only pay 20% commission on the sales the ads bring in.' },
  { q: 'Is the ad budget included?', a: 'No. Your ad budget is paid straight to Meta from your own card, so you stay in control of it. We agree the amount together, from R100 a day (about R3,000 a month).' },
  { q: 'How long does it take?', a: 'Most websites are live in 2 to 4 weeks once I have your content. You get a timeline in writing before anything starts.' },
  { q: 'Do I own the website?', a: 'Yes. It is yours. No monthly retainer to keep it online with me.' },
  { q: 'How do you track the 20%?', a: 'Sales are tracked through your website, booking system or store, and we agree how they are counted in writing before we start. You see the same numbers I do.' },
  { q: 'Why do you need to qualify me?', a: 'The offer works when a business already has customers and a little budget for ads. If you are not there yet, I will tell you honestly and point you to what makes sense instead.' },
];
---
<Base title="Website + Ads for R5,000 | Matthew Denton" description="A custom website and Meta ads set up and run for South African businesses. R5,000 once, then 20% only on sales the ads bring in.">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">For South African business owners</p>
        <h1>Get a website that brings in customers. <em>With your ads running from day one.</em></h1>
        <ul class="ticks">
          <li><b>Custom website, built for you.</b> Designed around your business and how your customers buy or book.</li>
          <li><b>Meta ads set up and run.</b> Ad account, pixel, copy and your first campaign, handled.</li>
          <li><b>R5,000 once, then 20% on sales.</b> I only earn more when your ads make you money.</li>
          <li><b>No retainer, no hidden fees.</b> You own your website. You deal with me directly.</li>
        </ul>
        <div class="proof">
          <div class="faces">{proof.map((c) => <span style={`background:${c.bg}`}><img src={c.logo} alt={c.name} width="44" height="44" loading="eager" /></span>)}</div>
          <p><b>R30k+ in client sales</b><br /><span>generated for businesses I work with</span></p>
        </div>
        <div class="criteria">
          <p class="tag">Minimum criteria</p>
          <ul>
            <li>Registered business in South Africa</li>
            <li>Trading for 6+ months</li>
            <li>Already selling a product or service</li>
            <li>R100 a day for ad spend</li>
          </ul>
          <p class="small"><span class="tag">No upfront ad fees</span> Ad spend is paid straight to Meta, from your own card.</p>
        </div>
      </div>

      <!-- APPLICATION CARD -->
      <div class="card" id="apply">
        <div class="card-head">
          <h2>See if you qualify</h2>
          <p>Takes about 2 minutes. Free, no obligation.</p>
          <div class="bar" aria-hidden="true"><i id="bar"></i></div>
        </div>
        <form id="app" novalidate>
          <div class="step" data-step="1">
            <label class="q" for="a-biz">Business name</label>
            <input id="a-biz" name="business" autocomplete="organization" placeholder="e.g. Bloom Hair Studio" />
            <p class="q">What type of business?</p>
            <div class="opts" data-name="type">{types.map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">What do you need?</p>
            <div class="opts" data-name="need" data-multi>{needs.map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
          </div>
          <div class="step" data-step="2" hidden>
            <p class="q">Is your business registered?</p>
            <div class="opts" data-name="registered">{['PTY or CC', 'Sole proprietor', 'Not registered yet'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">How long have you been trading?</p>
            <div class="opts" data-name="trading">{['Under 6 months', '6 to 12 months', '1 to 3 years', '3+ years'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">Do you have a website now?</p>
            <div class="opts" data-name="site">{['Yes, it works', 'Yes, but it needs work', 'No'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
          </div>
          <div class="step" data-step="3" hidden>
            <p class="q">How much can you spend on ads each month?</p>
            <div class="opts" data-name="budget">{['Under R3,000', 'R3,000 to R5,000', 'R5,000 to R10,000', 'R10,000+'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
            <p class="q">When do you want to start?</p>
            <div class="opts" data-name="when">{['This month', 'Next month', 'Just looking'].map((t) => <button type="button" class="opt" data-value={t}>{t}</button>)}</div>
          </div>
          <div class="step" data-step="4" hidden>
            <p class="good">✓ Good news, you look like a fit. Where should I send your plan?</p>
            <label class="q" for="a-name">Your name</label>
            <input id="a-name" name="name" autocomplete="name" />
            <label class="q" for="a-phone">WhatsApp number</label>
            <input id="a-phone" name="phone" type="tel" autocomplete="tel" placeholder="082 123 4567" />
            <label class="q" for="a-email">Email</label>
            <input id="a-email" name="email" type="email" autocomplete="email" />
            <input id="a-hp" name="company_url" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          </div>
          <div class="step done" data-step="no" hidden>
            <h3>Not quite yet</h3>
            <p>This offer works best for registered businesses that have been trading for 6+ months with at least R100 a day (about R3,000 a month) for ads. You are not far off.</p>
            <p>Message me anyway and I will tell you honestly what makes sense for where you are right now.</p>
            <a class="btn btn-ghost" id="no-wa" href="#" target="_blank" rel="noopener"><WaIcon /> Message Matt</a>
          </div>
          <div class="step done" data-step="yes" hidden>
            <h3>Application ready ✓</h3>
            <p>WhatsApp has opened with your details filled in. <b>Press send</b> and I will reply personally, usually the same day.</p>
            <p class="small">Didn't open? <a id="yes-wa" href="#" target="_blank" rel="noopener">Tap here to send it</a> or WhatsApp {contact.whatsappDisplay}.</p>
          </div>
          <p class="err" id="err" hidden></p>
          <div class="nav-btns" id="nav-btns">
            <button type="button" class="btn btn-ghost" id="back" hidden>Back</button>
            <button type="button" class="btn btn-primary" id="next">Continue →</button>
          </div>
        </form>
        <ul class="trust"><li>No upfront application fee</li><li>Reply within 24 hours</li><li>You own your site</li></ul>
      </div>
    </div>
  </section>

  <!-- PROOF BAND -->
  <section class="band">
    <div class="wrap band-inner">
      <div class="faces dark">{proof.map((c) => <span style={`background:${c.bg}`}><img src={c.logo} alt="" width="44" height="44" loading="lazy" /></span>)}</div>
      <div class="band-stats">
        {stats.slice(1).map((s) => <p><b class="num">{s.prefix}{s.value}{s.suffix}</b><span>{s.label}</span></p>)}
      </div>
    </div>
  </section>

  <!-- CALCULATOR -->
  <section class="section">
    <div class="wrap calc-grid">
      <div>
        <h2 class="h2">What would it <mark>actually cost you?</mark></h2>
        <p class="sub">Move the sliders. You pay R5,000 once, then 20% only on sales the ads bring in. No sales, no commission.</p>
        <div class="calc">
          <label class="q" for="c-val">Average sale or booking value <output id="o-val" class="num">R800</output></label>
          <input type="range" id="c-val" min="100" max="10000" step="100" value="800" />
          <label class="q" for="c-n">Extra sales from ads per month <output id="o-n" class="num">15</output></label>
          <input type="range" id="c-n" min="1" max="100" step="1" value="15" />
          <label class="q" for="c-ad">Monthly ad spend (paid to Meta) <output id="o-ad" class="num">R3,000</output></label>
          <input type="range" id="c-ad" min="3000" max="20000" step="500" value="3000" />
        </div>
      </div>
      <div class="est">
        <p class="tag-g">Your example month</p>
        <p class="big num" id="e-rev">R12,000</p>
        <p class="lbl">in sales from your ads</p>
        <dl>
          <div><dt>Ad spend (to Meta)</dt><dd class="num" id="e-ad">R2,000</dd></div>
          <div><dt>My 20% commission</dt><dd class="num" id="e-com">R2,400</dd></div>
          <div class="tot"><dt>Left for you</dt><dd class="num" id="e-left">R7,600</dd></div>
        </dl>
        <p class="small">An example only, not a promise of results. Plus the once-off R5,000 for your website and ads setup.</p>
        <a class="btn btn-primary" href="#apply">Check if I qualify</a>
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="section video-sec">
    <div class="wrap">
      <h2 class="h2 center">See how it works</h2>
      <div class="video">
        <!-- Drop your video at public/apply/intro.mp4 (and a poster frame at public/apply/intro.jpg) -->
        <video id="vid" controls playsinline preload="none" poster="/apply/intro.jpg" hidden><source src="/apply/intro.mp4" type="video/mp4" /></video>
        <div class="vid-ph" id="vid-ph"><span class="play">▶</span><p>Your 60 second intro video goes here</p></div>
      </div>
      <a class="btn btn-primary wide" href="#apply">Check if I qualify →</a>
    </div>
  </section>

  <!-- WORK -->
  <section class="section">
    <div class="wrap">
      <h2 class="h2">Businesses I've <mark>built for</mark></h2>
      <div class="work">
        <a href="/work/creative-pearls"><img src="/work/pearls-home.webp" alt="Creative Pearls website" loading="lazy" /><p><b>Creative Pearls</b> Handmade jewellery. Website and Meta ads.</p></a>
        <a href="/work"><img src="/work/ps-home.webp" alt="Party Starters website" loading="lazy" /><p><b>Party Starters</b> Party hire. Website, quote list and back office.</p></a>
        <a href="/work"><img src="/work/ad-home.webp" alt="Adamant Aesthetics website" loading="lazy" /><p><b>Adamant Aesthetics</b> Skin and laser clinic. Website with online booking.</p></a>
      </div>
    </div>
  </section>

  <!-- STEPS -->
  <section class="section steps-sec">
    <div class="wrap">
      <h2 class="h2 center">How it works</h2>
      <ol class="steps">
        <li><b>Apply</b><span>2 minutes. I check you are a fit and reply personally.</span></li>
        <li><b>Plan and build</b><span>A quick call, a fixed scope in writing, then I build your site in 2 to 4 weeks.</span></li>
        <li><b>Launch the ads</b><span>Your campaign goes live and I run it. You pay 20% only on the sales it brings in.</span></li>
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap faq-wrap">
      <h2 class="h2">Questions</h2>
      <div class="faq">{faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div>
    </div>
  </section>

  <section class="final">
    <div class="wrap center">
      <h2 class="h2">Ready for a website that <mark>pays for itself?</mark></h2>
      <p class="sub">I only take on a few new builds each month, so every client gets my full attention.</p>
      <a class="btn btn-primary" href="#apply">Check if I qualify →</a>
    </div>
  </section>

  <a class="sticky btn btn-primary" href="#apply" id="sticky">Check if I qualify</a>
</Base>

<script is:inline define:vars={{ number: contact.whatsappNumber, PIXEL_ID, CRM_INTAKE }}>
  // Meta Pixel (only loads when PIXEL_ID is set)
  if (PIXEL_ID) {
    !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', PIXEL_ID); fbq('track', 'PageView');
  }
  const track = (ev, data) => { try { if (window.fbq) fbq('track', ev, data || {}); } catch (e) {} };

  const form = document.getElementById('app');
  const steps = [...form.querySelectorAll('.step')];
  const bar = document.getElementById('bar');
  const err = document.getElementById('err');
  const back = document.getElementById('back');
  const next = document.getElementById('next');
  const navBtns = document.getElementById('nav-btns');
  const ans = { type: '', need: [], registered: '', trading: '', site: '', budget: '', when: '' };
  let cur = 1;

  form.querySelectorAll('.opts').forEach((group) => {
    const name = group.dataset.name, multi = group.hasAttribute('data-multi');
    group.addEventListener('click', (e) => {
      const b = e.target.closest('.opt'); if (!b) return;
      if (multi) { b.classList.toggle('on'); ans[name] = [...group.querySelectorAll('.on')].map((x) => x.dataset.value); }
      else { group.querySelectorAll('.opt').forEach((x) => x.classList.remove('on')); b.classList.add('on'); ans[name] = b.dataset.value; }
      err.hidden = true;
    });
  });

  const show = (id) => {
    steps.forEach((s) => (s.hidden = s.dataset.step !== String(id)));
    const n = typeof id === 'number' ? id : 4;
    bar.style.width = (typeof id === 'number' ? (id - 1) / 4 * 100 + 12 : 100) + '%';
    back.hidden = !(typeof id === 'number' && id > 1);
    navBtns.hidden = typeof id !== 'number';
    next.textContent = id === 4 ? 'Send my application →' : 'Continue →';
  };
  const fail = (msg) => { err.textContent = msg; err.hidden = false; };
  const val = (id) => String(document.getElementById(id).value || '').trim();
  const wa = (text) => `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
  // Send the application to the CRM too. Fire and forget, so WhatsApp still opens instantly.
  const qs = new URLSearchParams(location.search);
  const utm = (qs.get('utm_source') || '').toLowerCase();
  const source = utm === 'whatsapp' ? 'WhatsApp ad' : (qs.get('fbclid') || ['facebook', 'fb', 'ig', 'instagram', 'meta'].includes(utm)) ? 'Meta ad' : 'Website';
  const toCrm = (qualified) => {
    try {
      const d = new FormData();
      const add = (k, v) => d.append(k, v || '');
      add('name', val('a-name')); add('business', val('a-biz')); add('phone', val('a-phone')); add('email', val('a-email'));
      add('source', source); add('campaign', qs.get('utm_campaign') || ''); add('region', 'ZA'); add('qualified', qualified ? 'yes' : 'no');
      add('company_url', val('a-hp'));
      add('business_type', ans.type); add('needs', ans.need.join(', ')); add('registered', ans.registered); add('trading', ans.trading);
      add('current_website', ans.site); add('ad_budget', ans.budget); add('start', ans.when);
      add('message', qualified ? 'Applied for the R5k website + ads offer.' : 'Applied for the R5k offer but did not qualify yet.');
      fetch(CRM_INTAKE, { method: 'POST', body: d, keepalive: true }).catch(() => {});
    } catch (e) { /* never block the WhatsApp step */ }
  };
  const summary = () =>
    `Hi Matt, I'd like to apply for the website + ads offer.\n\n` +
    `Name: ${val('a-name')}\nBusiness: ${val('a-biz')} (${ans.type})\nNeed: ${ans.need.join(', ') || 'Not sure yet'}\n` +
    `Registered: ${ans.registered}\nTrading: ${ans.trading}\nWebsite now: ${ans.site}\n` +
    `Ad budget: ${ans.budget} a month\nStart: ${ans.when}\nWhatsApp: ${val('a-phone')}\nEmail: ${val('a-email')}`;

  next.addEventListener('click', () => {
    if (cur === 1) {
      if (!val('a-biz')) return fail('Add your business name.');
      if (!ans.type) return fail('Pick your type of business.');
      track('InitiateCheckout'); cur = 2; return show(2);
    }
    if (cur === 2) {
      if (!ans.registered || !ans.trading || !ans.site) return fail('Answer all three to continue.');
      cur = 3; return show(3);
    }
    if (cur === 3) {
      if (!ans.budget || !ans.when) return fail('Answer both to continue.');
      const no = ans.registered === 'Not registered yet' || ans.trading === 'Under 6 months' || ans.budget === 'Under R3,000';
      if (no) {
        document.getElementById('no-wa').href = wa(`Hi Matt, I filled in your application for ${val('a-biz')} (${ans.type}). I'm ${ans.registered.toLowerCase()}, trading ${ans.trading.toLowerCase()}, ad budget ${ans.budget}. What would you suggest for me?`);
        track('Contact', { content_name: 'not_qualified' });
        // Save them to the CRM straight away, even if they never tap Message Matt.
        if (!window.__mdSentNo) { window.__mdSentNo = true; toCrm(false); }
        cur = 'no'; return show('no');
      }
      cur = 4; return show(4);
    }
    if (cur === 4) {
      if (!val('a-name')) return fail('Add your name.');
      if (val('a-phone').replace(/\D/g, '').length < 9) return fail('Add a WhatsApp number I can reach you on.');
      const link = wa(summary());
      document.getElementById('yes-wa').href = link;
      track('Lead', { content_name: 'website_ads_offer', value: 5000, currency: 'ZAR' });
      toCrm(true);
      window.open(link, '_blank', 'noopener');
      cur = 'yes'; show('yes');
    }
  });
  back.addEventListener('click', () => { if (typeof cur === 'number' && cur > 1) { cur -= 1; err.hidden = true; show(cur); } });
  show(1);

  // Calculator
  const R = (n) => 'R' + Math.round(n).toLocaleString('en-ZA').replace(/ /g, ',');
  const cv = document.getElementById('c-val'), cn = document.getElementById('c-n'), ca = document.getElementById('c-ad');
  const calc = () => {
    const rev = +cv.value * +cn.value, ad = +ca.value, com = rev * 0.2;
    document.getElementById('o-val').textContent = R(+cv.value);
    document.getElementById('o-n').textContent = cn.value;
    document.getElementById('o-ad').textContent = R(ad);
    document.getElementById('e-rev').textContent = R(rev);
    document.getElementById('e-ad').textContent = R(ad);
    document.getElementById('e-com').textContent = R(com);
    document.getElementById('e-left').textContent = R(rev - ad - com);
  };
  [cv, cn, ca].forEach((el) => el.addEventListener('input', calc)); calc();

  // Show the real video once it exists
  const vid = document.getElementById('vid');
  fetch('/apply/intro.mp4', { method: 'HEAD' }).then((r) => { if (r.ok) { vid.hidden = false; document.getElementById('vid-ph').hidden = true; } }).catch(() => {});

  // Sticky mobile button hides while the form is on screen
  const sticky = document.getElementById('sticky');
  new IntersectionObserver(([e]) => sticky.classList.toggle('away', e.isIntersecting), { threshold: 0.2 }).observe(document.getElementById('apply'));
</script>

<style>
  .hero { padding-block: clamp(36px, 6vw, 80px) clamp(48px, 7vw, 96px); }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(28px, 5vw, 72px); align-items: start; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } }
  .hero-copy { display: grid; gap: 26px; }
  h1 { font-size: clamp(2.2rem, 1.6rem + 2.6vw, 3.9rem); }
  [hidden] { display: none !important; }
  h1 em { font-style: normal; color: var(--accent); }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ticks li { position: relative; padding-left: 36px; color: var(--muted); }
  .ticks li b { color: var(--ink); }
  .ticks li::before { content: '✓'; position: absolute; left: 0; top: 2px; width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center; background: var(--accent); color: var(--accent-ink); font-weight: 800; font-size: .8rem; }
  .proof { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
  .proof p { line-height: 1.3; } .proof span { color: var(--muted); font-size: .92rem; }
  .faces { display: flex; }
  .faces span { width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--bg); margin-left: -10px; overflow: hidden; display: grid; place-items: center; }
  .faces span:first-child { margin-left: 0; }
  .faces img { width: 80%; height: 80%; object-fit: contain; }
  .faces.dark span { border-color: var(--band); }
  .criteria { border: 1px solid var(--line); border-radius: var(--radius); padding: 20px 22px; background: var(--surface); display: grid; gap: 12px; }
  .criteria ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 8px 18px; font-size: .95rem; }
  .criteria li::before { content: '✓ '; color: var(--accent); font-weight: 700; }
  @media (max-width: 520px) { .criteria ul { grid-template-columns: 1fr; } }
  .tag { display: inline-block; background: var(--accent); color: var(--accent-ink); font-weight: 700; font-size: .78rem; letter-spacing: .06em; text-transform: uppercase; padding: 3px 8px; border-radius: 6px; justify-self: start; }
  .small { font-size: .88rem; color: var(--muted); }

  .card { background: var(--ink); color: #0b0f0e; border-radius: 22px; padding: clamp(20px, 3vw, 32px); box-shadow: 0 30px 80px -30px rgba(0,0,0,.8); position: sticky; top: 88px; scroll-margin-top: 90px; }
  @media (max-width: 900px) { .card { position: static; } }
  .card-head { display: grid; gap: 4px; margin-bottom: 18px; }
  .card h2 { font-size: var(--step-2); } .card-head p { color: #56605d; font-size: .95rem; }
  .bar { height: 5px; background: #dfe5e3; border-radius: 9px; overflow: hidden; margin-top: 10px; }
  .bar i { display: block; height: 100%; width: 12%; background: var(--accent-deep); transition: width .35s ease; }
  form { display: grid; gap: 14px; }
  .step { display: grid; gap: 10px; }
  .step[hidden] { display: none; }
  .q { font-weight: 650; font-size: .95rem; display: flex; justify-content: space-between; gap: 8px; margin-top: 6px; }
  .card input { font: inherit; color: #0b0f0e; background: #fff; border: 1.5px solid #d3dad8; border-radius: 10px; padding: 12px 14px; width: 100%; }
  .card input:focus { outline: none; border-color: var(--accent-deep); }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opt { font: 550 .92rem var(--f-body); border: 1.5px solid #d3dad8; background: #fff; color: #0b0f0e; border-radius: 999px; padding: 8px 14px; cursor: pointer; transition: border-color .15s, background .15s; }
  .opt:hover { border-color: var(--accent-deep); }
