---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
const path = [
  { when: '2016 to 2020', what: 'Advanced Life Support paramedic', why: 'Four years in emergency care. Clinical language, consent, calm under pressure and an instinct for how patients feel.' },
  { when: 'Then', what: 'Team lead in AI operations', why: 'Led data and quality teams at Invisible Technologies and FyxerAI. Systems, automation and checking the details twice.' },
  { when: 'Along the way', what: 'Café owner', why: 'I know what it is like to run the business and work in it on the same day.' },
  { when: 'Now', what: 'Booking systems for aesthetic clinics', why: 'Ads, content, websites and custom CRMs, plus my own brand Harlan, where I test everything first.' },
];
const principles = [
  { t: 'Measured on bookings', d: 'Not likes, reach or traffic. If it does not lead to a booked consult, it does not go in the report as a win.' },
  { t: 'Honest advertising', d: "No promised results, no misleading before-and-afters. Nothing I'd be uncomfortable seeing your name on." },
  { t: 'Tested with my own money', d: 'The ad setups and offers I recommend are ones I have run on my own brand first.' },
  { t: 'You deal with me', d: "No account managers. The person who builds your system is the person who answers your message." },
];
---
<Base title="About | Matthew Denton" description="Former paramedic and AI operations team lead, now building ads, websites and custom CRMs for aesthetic clinics.">
  <section class="section">
    <div class="wrap top">
      <div class="intro">
        <p class="eyebrow">About</p>
        <h1>A former paramedic who builds booking systems for clinics.</h1>
        <p class="lede">I'm Matt Denton. I help aesthetic clinics fill their consult diaries with one joined-up system: Meta ads, UGC, a website built to book, and a CRM coded around how the clinic works.</p>
        <p>I chose clinics because I understand them. I have worked in healthcare, I know what is at stake when someone trusts you with their face, and I know the results here can be measured in bookings, not guesses.</p>
      </div>
      <img class="portrait" src="/matt.webp" alt="Matthew Denton" width="720" height="960" />
    </div>
  </section>

  <section class="section-tight path-sec">
    <div class="wrap">
      <h2 class="h2">How I got here</h2>
      <ol class="path">
        {path.map((p) => (<li><span class="when">{p.when}</span><h3>{p.what}</h3><p>{p.why}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><h2 class="h2">What you can count on</h2></div>
      <div class="pr">
        {principles.map((p) => (<div><h3>{p.t}</h3><p>{p.d}</p></div>))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  h1 { font-size: var(--step-3); }
  .top { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .intro { display: grid; gap: 18px; }
  .intro p:not(.lede):not(.eyebrow) { color: var(--muted); }
  .portrait { width: 100%; max-width: 400px; height: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: var(--radius); justify-self: end; }
  @media (max-width: 860px) { .portrait { justify-self: start; max-width: 320px; } }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } }
  .path-sec { background: var(--surface); border-block: 1px solid var(--line); }
  .h2 { font-size: var(--step-3); }
  .path { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .path li { display: grid; gap: 8px; align-content: start; border-top: 2px solid var(--ink); padding-top: 16px; }
  .when { font-size: .85rem; font-weight: 650; color: var(--accent); }
  .path h3 { font-size: var(--step-1); letter-spacing: -0.015em; }
  .path p { color: var(--muted); font-size: .97rem; }
  @media (max-width: 900px) { .path { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .path { grid-template-columns: 1fr; } }
  .pr { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .pr div { background: var(--surface); padding: clamp(22px, 3vw, 34px); display: grid; gap: 8px; align-content: start; }
  .pr h3 { font-size: var(--step-1); }
  .pr p { color: var(--muted); }
  @media (max-width: 700px) { .pr { grid-template-columns: 1fr; } }
</style>
