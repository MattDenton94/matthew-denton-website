---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { contact } from '../data/site';
const path = [
  { when: '2016 to 2020', what: 'Advanced Life Support paramedic', why: 'Calm under pressure, and used to explaining complicated things simply.' },
  { when: 'Next', what: 'Team lead in AI data operations', why: 'Led annotation and quality teams at Invisible Technologies, then advanced annotation work at FyxerAI. This is where the automation side comes from.' },
  { when: 'Along the way', what: 'Café owner and property', why: 'I know what it feels like to be the small business owner doing everything at once.' },
  { when: 'Now', what: 'Websites, stores, ads and automations', why: 'Building for clients, and running my own brands Harlan and Nectra.' },
];
const principles = [
  { t: 'Built to bring in customers', d: 'Good looks are the start. Every page is laid out to turn a visitor into a message, a booking or a sale.' },
  { t: 'Fast on a real connection', d: 'Lean code and sized images, so it loads quickly on a phone with average mobile data.' },
  { t: 'Tested on my own money first', d: "The ad setups, offers and store structures I recommend are the ones I use on my own stores." },
  { t: 'Straight answers', d: "If something isn't worth your money, I'll say so. If I'm not the right person for the job, I'll tell you who is." },
];
---
<Base title="About | Matthew Denton" description="Matthew Denton: former paramedic and AI operations team lead, now building websites, stores, ads and automations for small businesses in Cape Town and beyond.">
  <section class="section">
    <div class="wrap top">
      <div class="head" style="margin:0">
        <p class="eyebrow">About</p>
        <h1>I build what I'd want built for my own business. Because I have my own businesses.</h1>
      </div>
      <div class="intro">
        <p class="lede">I'm Matt Denton, based in Cape Town. I work directly with small business owners on the things that get them customers online: the website or store, the ads, the design and the admin that should run on its own.</p>
        <p>There's no agency and no account manager. You message me, I do the work, and you can reach me on WhatsApp at <span class="mono">{contact.whatsappDisplay}</span>.</p>
      </div>
    </div>
  </section>

  <section class="section-tight path-sec">
    <div class="wrap">
      <p class="eyebrow">How I got here</p>
      <ol class="path">
        {path.map((p) => (<li><span class="mono when">{p.when}</span><h2>{p.what}</h2><p>{p.why}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head"><p class="eyebrow">How I work</p><h2 class="h2">Four things you can count on</h2></div>
      <div class="pr">
        {principles.map((p) => (<div><h3>{p.t}</h3><p>{p.d}</p></div>))}
      </div>
    </div>
  </section>
  <CtaBand title="Let's see if I can help." />
</Base>
<style>
  h1 { font-size: var(--step-3); }
  .top { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: end; }
  .intro { display: grid; gap: 16px; }
  .intro p:not(.lede) { color: var(--muted); }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } }
  .path-sec { background: var(--surface); border-block: 1px solid var(--line); }
  .path { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 28px; }
  .path li { display: grid; gap: 8px; align-content: start; border-top: 2px solid var(--ink); padding-top: 16px; }
  .when { font-size: .78rem; color: var(--accent); }
  .path h2 { font-size: var(--step-1); letter-spacing: -0.015em; }
  .path p { color: var(--muted); font-size: .97rem; }
  @media (max-width: 900px) { .path { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 540px) { .path { grid-template-columns: 1fr; } }
  .h2 { font-size: var(--step-3); }
  .pr { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .pr div { background: var(--surface); padding: clamp(22px, 3vw, 34px); display: grid; gap: 8px; align-content: start; }
  .pr h3 { font-size: var(--step-1); }
  .pr p { color: var(--muted); }
  @media (max-width: 700px) { .pr { grid-template-columns: 1fr; } }
</style>
